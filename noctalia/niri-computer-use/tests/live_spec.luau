--!nonstrict
local t = require("./support/t")
local env = require("./support/env")
local fx = require("./support/fixtures")

local live = env.module("lib/live.luau")
local time = env.module("lib/time.luau")

local F = fx.live()
-- Half a second after the fixtures' first call started.
local NOW = time.parse("2026-10-30T12:00:00.500Z")

local function holding(extra)
  local model = live.new()
  live.feed(model, fx.state(nil, extra), NOW)
  return model
end

t.group("live", function()
  t.test("follows the holder's call through its phases and keeps the aim at the end", function()
    local model = holding()
    t.ok(live.feed(model, F.click_aim, NOW), "the aim is a change")
    local view = live.view(model)
    t.ok(view.live, "the session writes live records")
    t.eq(view.call.phase, "aim")
    t.eq(view.call.aim.output, "HDMI-A-1")
    t.eq(view.call.aim.width, 2048)
    t.near(view.call.aim.points[1].y, 320.4, 0.001)
    t.ok(live.feed(model, F.click_end, NOW + 40))
    view = live.view(model)
    t.eq(view.call.phase, "end")
    t.eq(view.call.aim.points[1].x, 650)
    t.eq(view.call.error, nil)
    t.eq(view.call.endMs, NOW + 40)
  end)

  -- The bug: another agent's server, standalone beside the engine, ending the holder's
  -- call with a record of the same number.
  t.test("only the holder's records from since it took the lease count", function()
    local model = holding()
    live.feed(model, F.click_aim, NOW)
    t.ok(not live.feed(model, fx.with(F.click_end, { session = "pi/9" }), NOW), "another session's end")
    t.eq(model.call.phase, "aim")
    t.ok(not live.feed(model, F.type_aim, NOW), "another session's own call")
    local before = fx.with(F.launch_start, { ts = "2026-10-30T11:58:59.999Z" })
    t.ok(not live.feed(model, before, NOW), "a record from before the lease")
    t.eq(model.call.call, 1)
  end)

  t.test("a repeated or earlier phase and an earlier call's late record change nothing", function()
    local model = holding()
    live.feed(model, F.click_aim, NOW)
    t.ok(not live.feed(model, F.click_aim, NOW), "the same record twice")
    t.ok(not live.feed(model, fx.with(F.click_aim, { phase = "start" }), NOW), "a start after the aim")
    t.ok(live.feed(model, F.drag_aim, NOW), "the next call")
    t.ok(not live.feed(model, F.click_end, NOW), "the earlier call's end")
    t.eq(model.call.tool, "drag")
    t.eq(#model.call.aim.points, 2)
  end)

  t.test("an end alone shows its outcome, and another server's record replaces the call", function()
    local model = holding()
    live.feed(model, F.element_end_mismatch, NOW)
    t.eq(model.call.phase, "end")
    t.eq(model.call.error, "focus_mismatch")
    t.eq(model.call.app, "kitty")
    t.ok(live.feed(model, fx.with(F.launch_start, { pid = 2, call = 1 }), NOW), "a new engine counts from 1")
    t.eq(model.call.pid, 2)
    t.eq(model.call.phase, "start")
  end)

  t.test("watch's first record counts only while fresh and not ended, but marks the session", function()
    local model = holding()
    t.ok(live.feed(model, fx.with(F.click_end, { backlog = true }), NOW), "the session is known to write records")
    t.eq(model.call, nil)
    t.ok(live.view(model).live)
    local old = fx.with(F.click_aim, { backlog = true })
    t.ok(not live.feed(model, old, NOW + live.BACKLOG_MS + 1000), "an aim from over a minute ago")
    t.ok(live.feed(model, old, NOW), "a fresh aim")
    t.eq(model.call.phase, "aim")
  end)

  t.test("a new holder or a release drops the call, and only a release waves goodbye", function()
    local model = holding()
    live.feed(model, F.click_aim, NOW)
    live.feed(model, fx.state("pi/9"), NOW + 10)
    t.eq(model.call, nil)
    t.eq(model.releasedMs, nil)
    live.feed(model, fx.state(false), NOW + 20)
    t.eq(model.releasedMs, NOW + 20)
    t.eq(live.view(model).holder, nil)
    live.feed(model, fx.state(), NOW + 30)
    t.eq(model.releasedMs, nil)
    t.eq(model.heardMs, NOW + 30)
  end)

  t.test("an agent that asks has no call until it is let in", function()
    local model = holding({ pending = true })
    t.ok(not live.feed(model, F.click_aim, NOW))
    t.ok(live.view(model).holder.pending)
    live.feed(model, fx.state(), NOW)
    t.ok(live.feed(model, F.click_aim, NOW))
  end)

  t.test("a new watch drops the call until its first record says again what is in progress", function()
    local model = holding()
    live.feed(model, F.click_aim, NOW)
    t.ok(live.feed(model, { event = "hello", format = 1 }, NOW))
    t.eq(model.call, nil)
    t.ok(live.view(model).live, "the session still writes records")
    live.feed(model, fx.state(), NOW)
    t.ok(live.feed(model, fx.with(F.click_aim, { backlog = true }), NOW))
    t.eq(model.call.phase, "aim")
  end)

  t.test("a session without live records shows its acting calls from action lines until it sends one", function()
    local model = holding()
    local function action(tool, extra)
      local event = { event = "action", ts = "2026-10-30T12:00:00.000Z", session = fx.HOLDER, tool = tool, args = {} }
      for k, v in extra or {} do
        event[k] = v
      end
      return event
    end
    t.ok(not live.feed(model, action("screenshot"), NOW), "a reading tool")
    t.ok(not live.feed(model, action("click", { backlog = true }), NOW), "history")
    t.ok(live.feed(model, action("click", { error = "focus_mismatch" }), NOW))
    t.eq(model.legacy.tool, "click")
    t.eq(model.legacy.error, "focus_mismatch")
    t.ok(not live.view(model).live)
    live.feed(model, F.launch_start, NOW)
    t.eq(model.legacy, nil)
    t.ok(not live.feed(model, action("key"), NOW), "a session with live records")
  end)

  t.test("mistyped fields are skipped without an error", function()
    local model = holding()
    local odd = fx.with(F.click_aim, {
      aim = { output = "HDMI-A-1", area = { width = -4, height = 10 }, points = { { x = "1", y = 2 } } },
    })
    t.ok(live.feed(model, odd, NOW))
    t.eq(model.call.aim, nil)
    t.ok(not live.feed(model, fx.with(F.drag_aim, { pid = "1" }), NOW), "a pid that isn't a number")
    t.ok(not live.feed(model, fx.with(F.drag_aim, { phase = "later" }), NOW), "an unknown phase")
    local partial = fx.with(F.key_aim_floating, { aim = { output = "HDMI-A-1", area = { width = 800, height = 600 }, box = { x = 1 } } })
    live.feed(model, partial, NOW)
    t.eq(model.call.aim.box, nil)
    t.eq(#model.call.aim.points, 0)
    t.ok(not live.feed(model, { event = "later", pid = 1 }, NOW), "an unknown kind of line")
    t.ok(not live.feed(model, nil, NOW), "a line that wasn't JSON")
  end)

  t.test("counts a revision only for a change", function()
    local model = holding()
    local rev = model.rev
    live.feed(model, { event = "alive" }, NOW)
    live.feed(model, fx.state(), NOW)
    t.eq(model.rev, rev)
    live.feed(model, F.click_aim, NOW)
    t.eq(model.rev, rev + 1)
  end)
end)

return nil
