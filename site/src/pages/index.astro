---
// The home page, set as the server's manual page the way man shows it in a terminal: a
// running head and foot, capital section names, bold for what you type, underline for what
// man underlines, and less's reverse-video status line pinned to the bottom of the window.
// Dark or light follows the system. No JavaScript. Its words are in `lib/home.ts`, which
// `pages/index.md.ts` serves as Markdown too; its colours are the docs' (`styles/tokens.css`).
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import still from '../assets/errand-still.jpg';
import changelog from '../../../CHANGELOG.md?raw';
import { home } from '../lib/home';
import { mp4Seconds } from '../lib/clip';
import { manName, reference } from '../lib/man';
import { releases, summary } from '../lib/news';
import { siteRoot } from '../lib/markdown';
import { releaseLink, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => `${base}${path}`;
const canonical = siteRoot();
const og = new URL('demo/og.png', canonical).href;
const github = 'https://github.com/ayagmar/niri-computer-use';
const { install, example } = home;

// The clip's real length and size, read when the site is built.
const clipPath = `clips/${example.clip}.mp4`;
const clipFile = readFileSync(join(process.cwd(), 'public', clipPath));
const clipFacts = `${Math.round(mp4Seconds(clipFile))} s, MP4, ${Math.round(clipFile.byteLength / 1000)} KB`;
const history = releases(changelog).slice(0, 3);
const released = history.find((release) => release.version === version);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<title>{home.title}</title>
		<meta name="description" content={home.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={link('sitemap-index.xml')} />
		<link rel="alternate" type="text/markdown" href={link('index.md')} />
		<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={home.title} />
		<meta property="og:description" content={home.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f7f5ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#10110f" media="(prefers-color-scheme: dark)" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="running">
			<span>NIRI-COMPUTER-USE(1)</span>
			<span class="mid">User Commands</span>
			<span>NIRI-COMPUTER-USE(1)</span>
		</header>

		<main id="main">
			<section aria-labelledby="name">
				<p class="sh" aria-hidden="true">NAME</p>
				<h1 id="name"><b>niri-computer-use</b> - {home.name}</h1>
			</section>

			<section aria-labelledby="synopsis">
				<h2 id="synopsis">SYNOPSIS</h2>
				<p>
					<b>niri-computer-use</b>{' '}
					{home.commands.map((command, i) => <>{i > 0 && ' | '}<b>{command}</b></>)}
				</p>
			</section>

			<section aria-labelledby="description">
				<h2 id="description">DESCRIPTION</h2>
				{home.about.map((paragraph) => <p>{paragraph}</p>)}
			</section>

			<section aria-labelledby="install">
				<h2 id="install">INSTALLATION</h2>
				<p>Fetch the script, read it, run it:</p>
				<pre>{install.get}</pre>
				<pre>{install.read}</pre>
				<pre>{install.run}</pre>
				<p>Or build it, and use <u>~/.cargo/bin</u> below:</p>
				<pre>{install.cargo}</pre>
				<p>Bind the stop key in <u>config.kdl</u>:</p>
				<pre>{install.stop}</pre>
				<p>
					The script offers to register the server with Claude Code, Pi and Codex. Others:{' '}
					<a href={link('start/clients/')}>{reference(manName('start/clients'))}</a>.
				</p>
			</section>

			<section aria-labelledby="safety">
				<h2 id="safety">SAFETY</h2>
				<dl>
					{
						home.safety.map(([term, text]) => (
							<>
								<dt><b>{term}</b></dt>
								<dd>{text}</dd>
							</>
						))
					}
				</dl>
				<p>
					{home.sandbox} <a href={link('concepts/safety/')}>{reference(manName('concepts/safety'))}</a>.
				</p>
			</section>

			<section aria-labelledby="example">
				<h2 id="example">EXAMPLE</h2>
				<figure>
					<a class="still" href={link(clipPath)}>
						<Picture
							src={still}
							alt={example.alt}
							widths={[560, 900]}
							sizes="(min-width: 50rem) 560px, calc(100vw - 6ch)"
							formats={['avif']}
							fallbackFormat="jpg"
							quality={60}
							loading="eager"
							fetchpriority="high"
						/>
					</a>
					<figcaption>
						{example.caption} <a href={link(clipPath)}>Play the clip</a> ({clipFacts}).
					</figcaption>
				</figure>
				<table class="calls">
					<caption class="sr">Six of the session's calls and their round trips</caption>
					<thead><tr><th scope="col">call</th><th scope="col">ms</th></tr></thead>
					<tbody>
						{example.calls.map(([call, ms]) => <tr><td><code>{call}</code></td><td>{ms}</td></tr>)}
					</tbody>
				</table>
			</section>

			<section aria-labelledby="history">
				<h2 id="history">HISTORY</h2>
				<table>
					<caption class="sr">The latest releases</caption>
					<tbody>
						{
							history.map((release) => (
								<tr>
									<td><a href={`${github}/releases/tag/v${release.version}`}>{release.version}</a></td>
									<td>{release.date}</td>
									<td>{summary(release)}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p><a href={`${github}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a></p>
			</section>

			<section aria-labelledby="bugs">
				<h2 id="bugs">BUGS</h2>
				<p>{home.bugs}</p>
			</section>

			<section aria-labelledby="see-also">
				<h2 id="see-also">SEE ALSO</h2>
				<p class="refs">
					<a href="https://github.com/niri-wm/niri">niri(1)</a>,{' '}
					{home.seeAlso.map((id) => <><a href={link(`${id}/`)}>{reference(manName(id))}</a>, </>)}
					<a href={link('llms.txt')}>llms.txt</a>,{' '}
					<a href={github}>source</a>
				</p>
			</section>
		</main>

		<footer class="running">
			<a href={releaseLink}>niri-computer-use {version}</a>
			<span class="mid">{released?.date}</span>
			<span>NIRI-COMPUTER-USE(1)</span>
		</footer>

		<nav class="less" aria-label="Page">
			<span class="prompt"><span class="wide">Manual page niri-computer-use(1)</span><span class="pct" aria-hidden="true"></span></span>
			<a href="#install">install</a>
			<a href="#safety">safety</a>
			<a href={link('start/install/')}>docs</a>
			<a href={github}>source</a>
		</nav>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html {
		scroll-padding-bottom: 3.5rem;
		background: var(--ncu-ground);
		color: var(--ncu-ink);
		font: 400 16px/1.55 var(--ncu-mono);
		font-variant-ligatures: none;
		-webkit-text-size-adjust: 100%;
	}
	body {
		margin: 0;
		padding: 1.5rem 0 0;
	}
	body > header,
	main,
	body > footer {
		max-width: calc(80ch + 4ch);
		padding-inline: 2ch;
	}
	.skip {
		position: absolute;
		left: 2ch;
		top: -3rem;
		padding: 0.25rem 1ch;
		background: var(--ncu-ink);
		color: var(--ncu-ground);
	}
	.skip:focus {
		top: 0.5rem;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* Bold is the strongest ink, as a terminal shows groff's bold; underline is groff's
	   italic, for paths. Links are the amber. */
	b,
	strong,
	th,
	h2,
	pre {
		color: var(--ncu-bold);
	}
	b,
	strong,
	th,
	h2 {
		font-weight: 700;
	}
	u {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	a {
		color: var(--ncu-accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	a:hover {
		text-decoration-thickness: 2px;
	}

	.running {
		display: flex;
		justify-content: space-between;
		gap: 2ch;
		color: var(--ncu-dim);
	}
	body > footer.running {
		margin: 3em 0 1.5em;
	}
	h1 {
		margin: 0 0 0 7ch;
		font-size: 1em;
		font-weight: 400;
	}
	/* NAME is set as a section heading but the line under it is the page's h1, so screen
	   readers meet the h1 first. */
	h2,
	.sh {
		margin: 1.5em 0 0;
		font-size: 1em;
		font-weight: 700;
	}
	p,
	pre,
	dl,
	table,
	figure {
		margin: 0 0 0 7ch;
	}
	:is(p, pre, dl, table, figure) + :is(p, pre, dl, table, figure) {
		margin-top: 1em;
	}
	pre + pre {
		margin-top: 0.25em;
	}
	pre,
	code {
		font: inherit;
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		padding: 0.15em 1ch;
		background: var(--ncu-plate);
	}
	dl {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: 0.25em 2ch;
	}
	dd {
		margin: 0;
	}

	figure {
		max-width: 70ch;
	}
	.still {
		display: block;
		line-height: 0;
		border: 1px solid var(--ncu-rule);
	}
	.still img {
		display: block;
		width: 100%;
		height: auto;
	}
	figcaption {
		margin-top: 0.5em;
		color: var(--ncu-dim);
	}
	table {
		border-collapse: collapse;
	}
	th {
		text-align: left;
		padding: 0 3ch 0 0;
	}
	td {
		padding: 0 3ch 0 0;
		vertical-align: top;
		font-variant-numeric: tabular-nums;
	}
	.calls th:last-child,
	.calls td:last-child {
		text-align: right;
		padding-right: 0;
	}
	.refs a {
		white-space: nowrap;
	}

	/* less's status line, in reverse video at the bottom of the window. Where the browser
	   can tie an animation to scrolling, it shows how far down the page you are, as less does. */
	.less {
		position: sticky;
		bottom: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0 2ch;
		padding: 0.2rem 2ch;
		background: var(--ncu-ink);
		color: var(--ncu-ground);
	}
	.less .prompt {
		margin-right: auto;
	}
	.less a {
		color: var(--ncu-ground);
	}
	.less a:focus-visible {
		outline-color: var(--ncu-ground);
	}
	@property --ncu-read {
		syntax: '<integer>';
		inherits: true;
		initial-value: 0;
	}
	@supports (animation-timeline: scroll()) {
		.less {
			animation: ncu-read linear both;
			animation-timeline: scroll(root);
		}
		.pct::before {
			counter-reset: read var(--ncu-read);
			content: ' ' counter(read) '%';
		}
	}
	@keyframes ncu-read {
		to {
			--ncu-read: 100;
		}
	}

	@media (max-width: 40rem) {
		html {
			font-size: 14px;
		}
		body > header,
		main,
		body > footer {
			padding-inline: 1.5ch;
		}
		h1,
		p,
		pre,
		dl,
		table,
		figure {
			margin-left: 3ch;
		}
		dl {
			grid-template-columns: 1fr;
			gap: 0;
		}
		dd {
			margin: 0 0 0.5em 3ch;
		}
		.running .mid {
			display: none;
		}
		td {
			padding-right: 1.5ch;
		}
		td code {
			overflow-wrap: anywhere;
		}
		.less {
			padding-inline: 1.5ch;
		}
		.less .wide {
			display: none;
		}
		td:nth-child(2) {
			white-space: nowrap;
		}
	}

	/* On paper: black on white, without the status line, each outside link's address after it. */
	@media print {
		html {
			background: #fff;
			color: #000;
			font-size: 11pt;
		}
		b,
		strong,
		th,
		h2,
		pre,
		a,
		.running,
		figcaption {
			color: #000;
		}
		pre {
			background: none;
		}
		.less,
		.skip {
			display: none;
		}
		main a[href^='http']::after {
			content: ' <' attr(href) '>';
			word-break: break-all;
		}
	}
</style>
