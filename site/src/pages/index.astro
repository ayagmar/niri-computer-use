---
// The home page, set as a hand-made project page from around 2000: a 760-pixel page on the
// desktop grey, a title band with the pixel mark, bevelled buttons down the side, tables for
// facts, one framed still that opens the clip, and a status bar. Light only, no JavaScript.
// Its words are in `lib/home.ts`, which `pages/index.md.ts` serves as Markdown too.
import '@fontsource/tinos/400.css';
import '@fontsource/tinos/700.css';
import tinos from '@fontsource/tinos/files/tinos-latin-400-normal.woff2?url';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import Mark from '../components/home/Mark.astro';
import Buttons from '../components/home/Buttons.astro';
import still from '../assets/errand-still.jpg';
import changelog from '../../../CHANGELOG.md?raw';
import { home } from '../lib/home';
import { mp4Seconds } from '../lib/clip';
import { releases, summary } from '../lib/news';
import { siteRoot } from '../lib/markdown';
import { releaseLink, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => `${base}${path}`;
const canonical = siteRoot();
const og = new URL('demo/og.png', canonical).href;
const github = 'https://github.com/ayagmar/niri-computer-use';
const { clip, glance, install, safety } = home;

// The clip's real length and size, read when the site is built.
const clipFile = readFileSync(join(process.cwd(), 'public', 'clips', `${clip.name}.mp4`));
const clipFacts = `${Math.round(mp4Seconds(clipFile))} s, MP4, ${Math.round(clipFile.byteLength / 1000)} KB`;
const news = releases(changelog).slice(0, 3);
const latest = news[0];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<title>{home.title}</title>
		<meta name="description" content={home.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={link('sitemap-index.xml')} />
		<link rel="alternate" type="text/markdown" href={link('index.md')} />
		<link rel="preload" href={tinos} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={home.title} />
		<meta property="og:description" content={home.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#336666" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div class="page">
			<header class="band">
				<Mark />
				<div>
					<h1>niri-computer-use</h1>
					<p>{home.tagline} <strong>{home.stop}</strong></p>
				</div>
			</header>

			<nav class="side" aria-label="Site">
				<ul>
					<li><a class="bevel" href="#install">Install</a></li>
					<li><a class="bevel" href="#safety">Safety</a></li>
					<li><a class="bevel" href="#news">What’s new</a></li>
					<li><a class="bevel" href={link('start/install/')}>Documentation</a></li>
					<li><a class="bevel" href={github}>Source</a></li>
					<li><a class="bevel" href={link('llms.txt')}>llms.txt</a></li>
				</ul>
			</nav>

			<main id="main">
				<p class="only">{home.only}</p>

				<figure class="shot">
					<a href={link(`clips/${clip.name}.mp4`)} class="frame">
						<Picture
							src={still}
							alt={clip.alt}
							widths={[560, 900]}
							sizes="(min-width: 760px) 540px, calc(100vw - 40px)"
							formats={['avif']}
							fallbackFormat="jpg"
							quality={60}
							loading="eager"
							fetchpriority="high"
						/>
					</a>
					<figcaption>
						{clip.caption} <a href={link(`clips/${clip.name}.mp4`)}>Play the clip</a> <span class="nw">({clipFacts})</span>.
						<span>{clip.note}</span>
					</figcaption>
				</figure>

				<table class="facts">
					<caption class="sr">At a glance</caption>
					<tbody>
						{glance.map(([what, value]) => <tr><th scope="row">{what}</th><td>{value}</td></tr>)}
					</tbody>
				</table>

				<h2 id="install">Install</h2>
				<ol class="steps">
					{
						install.map((step) => (
							<li>
								<b>{step.label}.</b> {step.note}
								{step.more && <>{' '}<a href={link(step.more.link)}>{step.more.text}</a>.</>}
								<pre>{step.code}</pre>
								{step.read && (
									<>
										<span class="or">Read it:</span>
										<pre>{step.read}</pre>
										<span class="or">Then run it:</span>
										<pre>{step.run}</pre>
									</>
								)}
								{step.or && (
									<>
										<span class="or">{step.orNote}</span>
										<pre>{step.or}</pre>
									</>
								)}
							</li>
						))
					}
				</ol>

				<h2 id="safety">Safety</h2>
				<div class="ledger">
					<div>
						<h3>Enforced</h3>
						<ul>{safety.enforced.map((item) => <li>{item}</li>)}</ul>
					</div>
					<div>
						<h3>Not covered</h3>
						<ul>{safety.missed.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
				<p><a href={link(safety.more.link)}>{safety.more.text}</a>.</p>

				<h2 id="news">What’s new</h2>
				<table class="news">
					<thead><tr><th scope="col">Release</th><th scope="col">Date</th><th scope="col">Changes</th></tr></thead>
					<tbody>
						{
							news.map((release) => (
								<tr>
									<td><a href={`${github}/releases/tag/v${release.version}`}>{release.version}</a></td>
									<td>{release.date}</td>
									<td>{summary(release)}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p><a href={`${github}/blob/main/CHANGELOG.md`}>Full changelog</a>.</p>
			</main>

			<aside class="more" aria-label="More">
				<h2>Built on</h2>
				<Buttons />
			</aside>

			<footer class="status">
				<span>Best viewed with any browser</span>
				<span>No JavaScript</span>
				<span><a href={releaseLink}>{version}</a>{latest && latest.version === version && `, ${latest.date}`}</span>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--desk: #c0c0c0;
		--paper: #ffffff;
		--face: #e4e4dc;
		--ink: #000000;
		--ink-2: #3c3c38;
		--band: #336666;
		--band-ink: #ffffff;
		--bar: #dfe9e9;
		--bar-ink: #133333;
		--hi: #ffffff;
		--lo: #808080;
		--dk: #404040;
		--link: #0000cc;
		--visited: #663399;
		--active: #cc0000;
		--note: #ffffcc;
		--ring: #ffcc33;
		--ring-edge: #0f2626;
		--serif: 'Tinos', 'Times New Roman', Times, 'Liberation Serif', serif;
		--mono: 'DejaVu Sans Mono', 'Liberation Mono', 'Courier New', monospace;
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	html {
		background: var(--desk);
		color: var(--ink);
		font: 17px/1.45 var(--serif);
		-webkit-text-size-adjust: 100%;
		scrollbar-color: var(--lo) var(--desk);
		caret-color: var(--active);
	}
	body {
		margin: 0;
		padding: 24px 12px 40px;
	}
	::selection {
		background: var(--band);
		color: var(--band-ink);
	}
	a {
		color: var(--link);
		text-underline-offset: 2px;
	}
	a:visited {
		color: var(--visited);
	}
	a:active {
		color: var(--active);
	}
	/* Keyboard focus is niri's focus ring, as the mark draws it: amber around a dark edge. */
	a:focus-visible {
		outline: 2px solid transparent;
		box-shadow:
			0 0 0 2px var(--ring-edge),
			0 0 0 5px var(--ring),
			0 0 0 6px var(--ring-edge);
	}
	.skip {
		position: absolute;
		left: 12px;
		top: -40px;
		padding: 4px 8px;
		background: var(--paper);
	}
	.skip:focus {
		top: 4px;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* The page: a 760-pixel table of title band, side column, main column and status bar. */
	.page {
		max-width: 760px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 160px 1fr;
		grid-template-areas:
			'band band'
			'side main'
			'more main'
			'status status';
		grid-template-rows: auto auto 1fr auto;
		background: var(--paper);
		border: 2px solid;
		border-color: var(--hi) var(--dk) var(--dk) var(--hi);
		box-shadow: 1px 1px 0 var(--ink);
	}
	.band {
		grid-area: band;
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 14px 18px;
		background: var(--band);
		color: var(--band-ink);
	}
	.mark {
		flex: none;
	}
	h1 {
		margin: 0;
		font-size: 30px;
		line-height: 1.1;
		letter-spacing: 0;
	}
	.band p {
		margin: 2px 0 0;
		font-size: 16px;
	}
	.band strong {
		color: #ffdd77;
	}

	.side,
	.more {
		background: var(--face);
		border-right: 1px solid var(--lo);
		padding: 14px 12px 0;
	}
	.side {
		grid-area: side;
	}
	.more {
		grid-area: more;
		padding-bottom: 16px;
		font-size: 15px;
	}
	.side ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 6px;
	}
	.bevel {
		display: block;
		padding: 3px 8px;
		background: var(--face);
		border: 2px solid;
		border-color: var(--hi) var(--dk) var(--dk) var(--hi);
		box-shadow: inset -1px -1px 0 var(--lo);
		color: var(--ink);
		font-weight: 700;
		font-size: 15px;
		text-decoration: none;
	}
	.bevel:visited {
		color: var(--ink);
	}
	.bevel:hover {
		background: #efefe8;
	}
	.bevel:active {
		border-color: var(--dk) var(--hi) var(--hi) var(--dk);
		box-shadow: inset 1px 1px 0 var(--lo);
		color: var(--ink);
	}
	.more h2 {
		margin: 18px 0 6px;
		font-size: 15px;
		border-bottom: 1px solid var(--lo);
	}

	main {
		grid-area: main;
		min-width: 0;
		padding: 16px 22px 18px;
	}
	main p {
		margin: 0 0 12px;
	}
	.only {
		padding: 4px 10px;
		background: var(--note);
		border: 1px solid #996600;
		font-weight: 700;
	}
	h2 {
		margin: 26px 0 10px;
		padding: 2px 8px;
		background: var(--bar);
		color: var(--bar-ink);
		font-size: 19px;
		border-top: 1px solid #9fbcbc;
		border-bottom: 1px solid #9fbcbc;
	}
	h3 {
		margin: 0 0 4px;
		font-size: 16px;
	}

	.shot {
		margin: 16px 0;
	}
	.frame {
		display: block;
		padding: 4px;
		background: var(--face);
		border: 2px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
		line-height: 0;
	}
	.frame img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--ink);
	}
	.frame:focus-visible {
		outline-offset: 3px;
	}
	figcaption {
		margin: 6px 0 0;
		font-size: 15px;
		color: var(--ink-2);
	}
	figcaption > span:last-child {
		display: block;
	}
	.nw {
		white-space: nowrap;
	}

	table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 2px;
		margin: 0 0 12px;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
		font-size: 16px;
	}
	th,
	td {
		padding: 3px 8px;
		text-align: left;
		vertical-align: top;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
	}
	tbody th,
	thead th {
		background: var(--face);
		font-weight: 700;
	}
	.facts th {
		width: 108px;
	}
	.news td:first-child,
	.news td:nth-child(2) {
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.steps {
		margin: 0 0 12px;
		padding-left: 24px;
	}
	.steps li {
		margin-bottom: 12px;
	}
	.steps li::marker {
		font-weight: 700;
	}
	pre {
		margin: 4px 0 0;
		padding: 6px 10px;
		background: #f4f4ee;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
		box-shadow: inset 1px 1px 0 var(--dk);
		font: 13.5px/1.45 var(--mono);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.or {
		display: block;
		margin: 4px 0 0;
		font-style: normal;
		font-size: 15px;
		color: var(--ink-2);
	}

	.ledger {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		margin: 0 0 12px;
		padding: 2px;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
	}
	.ledger > div {
		padding: 6px 10px 8px;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
	}
	.ledger > div + div {
		background: #fff8ee;
	}
	.ledger ul {
		margin: 0;
		padding-left: 18px;
		font-size: 16px;
	}

	.status {
		grid-area: status;
		display: flex;
		flex-wrap: wrap;
		gap: 3px;
		padding: 3px;
		background: var(--face);
		border-top: 1px solid var(--lo);
		font-size: 14px;
	}
	.status span {
		flex: 1 1 auto;
		padding: 1px 8px;
		border: 1px solid;
		border-color: var(--lo) var(--hi) var(--hi) var(--lo);
	}
	.status span:last-child {
		flex: 0 0 auto;
	}

	/* Phones: one column, the side buttons in a row under the band. */
	@media (max-width: 640px) {
		html {
			font-size: 16px;
		}
		body {
			padding: 0;
		}
		.page {
			grid-template-columns: 1fr;
			grid-template-areas: 'band' 'side' 'main' 'more' 'status';
			grid-template-rows: auto;
			border: 0;
			box-shadow: none;
		}
		.band {
			padding: 12px;
			gap: 12px;
		}
		h1 {
			font-size: 24px;
		}
		.side {
			border-right: 0;
			border-bottom: 1px solid var(--lo);
			padding: 8px;
		}
		.side ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.bevel {
			text-align: center;
			padding: 3px 4px;
		}
		.more {
			border-right: 0;
			border-top: 1px solid var(--lo);
		}
		main {
			padding: 12px 12px 16px;
		}
		.ledger {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 380px) {
		.side ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* On paper: no side column or buttons, and each outside link's address after it. */
	@media print {
		html,
		body {
			background: #fff;
			padding: 0;
		}
		.page {
			display: block;
			border: 0;
			box-shadow: none;
		}
		.side,
		.more,
		.status,
		.skip {
			display: none;
		}
		.band {
			background: none;
			color: #000;
			border-bottom: 2px solid #000;
		}
		.band strong {
			color: #000;
		}
		main a[href^='http']::after {
			content: ' <' attr(href) '>';
			font-size: 0.85em;
			word-break: break-all;
		}
	}
</style>
