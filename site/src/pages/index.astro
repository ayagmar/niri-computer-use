---
// The home page, set as a datasheet: a running head, timing diagrams drawn from real
// sessions, tables for what the server answers and refuses, then install. It sits outside
// Starlight and loads only its own styles; `styles/tokens.css` keeps its theme and
// crossfade in step with the docs.
import '@fontsource-variable/archivo/wdth.css';
import '../generated/archivo-text.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import archivo from '../generated/archivo-text.woff2?url';
import Timing from '../components/home/Timing.astro';
import Result from '../components/home/Result.astro';
import Gates from '../components/home/Gates.astro';
import Code from '../components/home/Code.astro';
import { home } from '../lib/home';
import { siteRoot } from '../lib/markdown';
import { releaseLink, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => `${base}${path}`;
const canonical = siteRoot();
const og = new URL('demo/og.png', canonical).href;
const github = 'https://github.com/ayagmar/niri-computer-use';
const { sessions, result, gates, limits, requirements, install } = home;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{home.title}</title>
		<meta name="description" content={home.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={link('sitemap-index.xml')} />
		<link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={home.title} />
		<meta property="og:description" content={home.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f4f5f2" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f1110" media="(prefers-color-scheme: dark)" />
		{/* The theme the docs pages store, or the system's; `js` for what only works with the
		    script, and `sweep` to hold the first diagram back until it draws itself in. */}
		<script is:inline>
			const root = document.documentElement;
			root.dataset.theme =
				localStorage.getItem('starlight-theme') ||
				(matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
			root.classList.add('js');
			if (matchMedia('(prefers-reduced-motion: no-preference)').matches) root.classList.add('sweep');
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div class="sheet">
			<header class="top">
				<span class="mast">
					<a class="name" href={base} aria-current="page">niri-computer-use</a>
					<a class="version" href={releaseLink} aria-label={`Release ${version}`}>{version}</a>
				</span>
				<span class="running">{home.running}</span>
				<nav aria-label="Site">
					<a href={link('start/install/')}>Docs</a>
					<a href={github}>GitHub</a>
					<button class="theme" type="button" data-theme-toggle aria-label="Use the dark theme">
						<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5.5"></circle><path d="M12 6.5a5.5 5.5 0 0 1 0 11z"></path></svg>
					</button>
					<a class="button small" href="#install">Install</a>
				</nav>
			</header>
			<main id="main">
				<section class="hero" aria-labelledby="hero-title">
					<h1 id="hero-title"><span>{home.headline}</span> <em>{home.stopline}</em></h1>
					<div class="lede">
						<p>{home.lede}</p>
						<div class="actions">
							<a class="button" href="#install">Install</a>
							<a class="more" href={link(home.safety.link)}>{home.safety.text}</a>
						</div>
					</div>
				</section>
				<Timing items={sessions.items} caption={sessions.caption} note={sessions.note} try={sessions.try} />

				<section class="part" aria-labelledby="result-title">
					<div class="part-head">
						<h2 id="result-title">{result.headline}</h2>
						<p>{result.lede}</p>
					</div>
					<Result
						code={result.code}
						fields={result.fields}
						source={result.source}
						sourceLink={`${github}/blob/main/docs/results/readme-example.md`}
					/>
					<a class="more" href={link(result.more.link)}>{result.more.text}</a>
				</section>

				<section class="part" aria-labelledby="gates-title">
					<div class="part-head">
						<h2 id="gates-title">{gates.headline}</h2>
						<p>{gates.lede}</p>
					</div>
					<Gates items={gates.items} pass={gates.pass} note={gates.note} />
				</section>

				<section class="part" aria-labelledby="limits-title">
					<div class="part-head">
						<h2 id="limits-title">{limits.headline}</h2>
					</div>
					<div class="limits">
						{
							[limits.enforces, limits.misses].map((group) => (
								<div>
									<h3>{group.title}</h3>
									<ul>
										{group.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</div>
							))
						}
					</div>
					<a class="more" href={link(limits.more.link)}>{limits.more.text}</a>
				</section>

				<section class="part" aria-labelledby="needs-title">
					<div class="part-head">
						<h2 id="needs-title">{requirements.headline}</h2>
					</div>
					<table class="needs">
						<tbody>
							{
								requirements.rows.map(([what, value]) => (
									<tr>
										<th scope="row">{what}</th>
										<td>{value}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</section>

				<section class="part" id="install" aria-labelledby="install-title">
					<div class="part-head">
						<h2 id="install-title">{install.headline}</h2>
						<p>{install.lede}</p>
					</div>
					<ol class="steps">
						{
							install.steps.map((step) => (
								<li>
									<p>
										{step.text}
										{step.more && (
											<>
												{' '}
												<a href={link(step.more.link)}>{step.more.text}</a>
											</>
										)}
									</p>
									<Code code={step.code} lang={step.lang} />
									{step.or && (
										<>
											<p>
												{step.or.text} <a href={link(step.or.more.link)}>{step.or.more.text}</a>
											</p>
											<Code code={step.or.code} lang={step.or.lang} />
										</>
									)}
								</li>
							))
						}
					</ol>
					<a class="more" href={link(install.more.link)}>{install.more.text}</a>
				</section>
			</main>
			<footer class="end">
				<span class="name">niri-computer-use <a class="version" href={releaseLink}>{version}</a></span>
				<nav aria-label="More">
					<a href={link('start/install/')}>Docs</a>
					<a href={github}>GitHub</a>
					<a href={link(home.agents.link)}>{home.agents.text}</a>
					<a href={`${github}/blob/main/LICENSE`}>MIT license</a>
				</nav>
			</footer>
		</div>
		<script>
			// The theme button switches between dark and light and stores the choice where the docs
			// pages read it.
			const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
			const label = () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				button.setAttribute('aria-label', `Use the ${next} theme`);
				return next;
			};
			label();
			button.addEventListener('click', () => {
				const next = label();
				document.documentElement.dataset.theme = next;
				localStorage.setItem('starlight-theme', next);
				label();
			});
			// A stop in the diagram marks the headline's promise.
			document.addEventListener('ncu-stop', () => document.querySelector('h1 em')?.classList.add('hit'));
		</script>
	</body>
</html>

<style is:global>
	/* Paper and ink, a highlighter for what the reader is pointing at, and one red for the
	   stop key and refused answers. */
	:root {
		--sans: 'Archivo Variable', ui-sans-serif, system-ui, sans-serif;
		--mono: 'JetBrains Mono Variable', ui-monospace, 'DejaVu Sans Mono', monospace;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		--paper: #f4f5f2;
		--ink: #121413;
		--ink-2: #545a56;
		--rule: #c8ccc5;
		--grid: #e3e6e0;
		--red: #c9281a;
		--red-lip: #8a1a10;
		/* Text on a red fill, and red text on the highlighter. */
		--on-red: #fff;
		--red-on-mark: var(--red);
		--mark: #fdf0a6;
		--mark-strong: #ffd60a;
		--plate: #121413;
		--plate-ink: #eceee9;
		--plate-rule: #3a3f3c;
	}

	:root[data-theme='dark'] {
		--paper: #0f1110;
		--ink: #e9ebe6;
		--ink-2: #a3aaa5;
		--rule: #343935;
		--grid: #1c201e;
		--red: #ff6150;
		--red-lip: #a3271b;
		--on-red: #0f1110;
		--red-on-mark: #ff7a6b;
		--mark: #39340f;
		--plate: #1b1e1c;
		--plate-rule: #3d433f;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--paper);
		color: var(--ink);
		font: 400 1rem/1.5 var(--sans);
		-webkit-text-size-adjust: 100%;
		text-rendering: optimizeLegibility;
	}

	/* Over the docs' own, which tokens.css sets on :root. */
	html:root {
		caret-color: var(--red);
		scrollbar-color: var(--ink-2) var(--paper);
		accent-color: var(--ink);
	}

	::selection {
		background: var(--mark-strong);
		color: #121413;
	}

	:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	body {
		margin: 0;
		overflow-x: clip;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	a {
		color: inherit;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	a:hover {
		text-decoration-thickness: 2px;
	}

	h1,
	h2,
	h3,
	p,
	ul,
	ol {
		margin: 0;
	}

	.vh {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -4rem;
		z-index: 9;
		padding: 0.75rem 1rem;
		background: var(--ink);
		color: var(--paper);
		border-radius: 3px;
	}

	.skip:focus {
		top: 0.75rem;
	}

	.sheet {
		max-width: 86rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2.5rem);
	}

	.top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		min-height: 3.5rem;
		border-bottom: 1px solid var(--ink);
		font-size: 0.875rem;
	}

	.name {
		font-weight: 760;
		font-stretch: 88%;
		font-size: 1.125rem;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.mast {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.version {
		padding: 0.05rem 0.35rem;
		border: 1px solid var(--rule);
		font: 500 0.75rem/1.4 var(--mono);
		font-stretch: normal;
		letter-spacing: 0;
		color: var(--ink-2);
		text-decoration: none;
		transition: background-color 160ms var(--ease), color 160ms var(--ease);
	}

	.version:hover,
	.version:focus-visible {
		background: var(--mark);
		color: var(--ink);
	}

	.running {
		color: var(--ink-2);
		white-space: nowrap;
	}

	.top nav {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.top nav > a:not(.button) {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 0.6rem;
		font-weight: 550;
		text-decoration: none;
	}

	.top nav > a:not(.button):hover {
		text-decoration: underline;
	}

	.theme {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	/* Without the script the button can't switch anything. */
	:global(html:not(.js)) .theme {
		display: none;
	}

	.theme svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		transition: transform 400ms var(--ease);
	}

	.theme path {
		fill: currentColor;
		stroke: none;
	}

	:global([data-theme='dark']) .theme svg {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.theme svg,
		h1 em {
			transition: none;
		}
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 1.4rem;
		border-radius: 3px;
		background: var(--ink);
		color: var(--paper);
		font-weight: 650;
		text-decoration: none;
		transition: transform 140ms var(--ease), background-color 160ms var(--ease);
	}

	.button.small {
		margin-left: 0.5rem;
		min-height: 2.5rem;
		padding: 0 1rem;
	}

	.button:hover {
		background: var(--ink-2);
	}

	.button:active {
		transform: scale(0.97);
	}

	.more {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 600;
	}

	.hero {
		padding: clamp(2rem, 6vh, 3.5rem) 0 clamp(1.75rem, 4vh, 2.5rem);
	}

	h1 {
		font-weight: 780;
		font-stretch: 84%;
		font-size: clamp(2.375rem, 1.1rem + 4vw, 4.75rem);
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	h1 span,
	h1 em {
		display: inline-block;
	}

	h1 em {
		font-style: normal;
		color: var(--red);
		/* A highlighter stroke under the line, drawn when a stop lands in the diagram. */
		background: linear-gradient(var(--mark-strong), var(--mark-strong)) no-repeat 0 88% / 0% 0.28em;
		transition: background-size 700ms var(--ease);
	}

	h1 em:global(.hit) {
		background-size: 100% 0.28em;
	}

	.lede {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1.25rem 3rem;
		margin-top: clamp(1.25rem, 3vh, 1.75rem);
	}

	.lede p {
		max-width: 58ch;
		font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
		line-height: 1.5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
	}

	.part {
		position: relative;
		margin-top: clamp(4rem, 10vh, 6.5rem);
		border-top: 2px solid var(--ink);
		padding-top: 1rem;
	}

	/* Each section's rule is drawn across as the section scrolls in. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.part {
				border-top-color: transparent;
			}

			.part::before {
				content: '';
				position: absolute;
				top: -2px;
				left: 0;
				right: 0;
				height: 2px;
				background: var(--ink);
				transform-origin: left;
				animation: rule linear both;
				animation-timeline: view();
				animation-range: entry 10% entry 70%;
			}
		}
	}

	@keyframes rule {
		from {
			transform: scaleX(0);
		}

		to {
			transform: scaleX(1);
		}
	}

	.part-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
		gap: 0.75rem 3rem;
		margin-bottom: 2rem;
	}

	h2 {
		font-weight: 760;
		font-stretch: 84%;
		font-size: clamp(1.875rem, 1.2rem + 2vw, 2.875rem);
		line-height: 1;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.part-head p {
		max-width: 56ch;
		font-size: 1.0625rem;
		line-height: 1.5;
		color: var(--ink-2);
		padding-top: 0.35rem;
	}

	.part > .more {
		margin-top: 0.75rem;
	}

	.limits {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 3rem;
	}

	h3 {
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-2);
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--ink);
	}

	.limits ul {
		list-style: none;
		padding: 0;
	}

	.limits li {
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--rule);
		line-height: 1.5;
	}

	.needs {
		width: 100%;
		border-collapse: collapse;
		border-top: 1px solid var(--ink);
	}

	.needs th,
	.needs td {
		text-align: left;
		vertical-align: top;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--rule);
		line-height: 1.5;
	}

	.needs th {
		width: 12rem;
		padding-right: 2rem;
		font-weight: 650;
	}

	.steps {
		list-style: none;
		padding: 0;
		counter-reset: step;
		display: grid;
		gap: 1.75rem;
		max-width: 60rem;
	}

	.steps li {
		counter-increment: step;
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: 0.6rem 0.5rem;
	}

	.steps li::before {
		content: counter(step);
		grid-row: span 4;
		font: 700 1.25rem/1.4 var(--mono);
	}

	.steps p {
		line-height: 1.5;
	}

	.steps a {
		font-weight: 600;
	}

	.end {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: clamp(4rem, 10vh, 6rem);
		padding: 1rem 0 2.5rem;
		border-top: 1px solid var(--ink);
		font-size: 0.875rem;
	}

	.end nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
	}

	.end nav a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
	}

	@media (max-width: 56rem) {
		.running {
			display: none;
		}

		.top {
			grid-template-columns: 1fr auto;
		}

		.part-head,
		.limits {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 30rem) {
		.top nav > a:not(.button) {
			padding: 0 0.4rem;
		}

		.button.small {
			display: none;
		}

		.needs th {
			width: 6.5rem;
			padding-right: 1rem;
		}
	}

	/* Too narrow for the version beside the name; the footer still gives it. */
	@media (max-width: 24rem) {
		.mast .version {
			display: none;
		}
	}
</style>
