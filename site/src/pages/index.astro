---
// The home page, set as the server's manual page the way man shows it in a terminal
// (`styles/man.css`), in a niri workspace on a wide screen: the man page is the focused
// column, in the focus ring, and EXAMPLE is the next column, half in view. Dark or light
// follows the system. Without JavaScript it reads in full and the clip opens from a link;
// `scripts/less.ts` adds less's keys, the columns' focus and the clip's replay. Its words are
// in `lib/home.ts`, which `pages/index.md.ts` serves as Markdown too.
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/man.css';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import Less from '../components/Less.astro';
import Slide from '../components/Slide.astro';
import still from '../assets/errand-still.jpg';
import changelog from '../../../CHANGELOG.md?raw';
import { home } from '../lib/home';
import { mp4Seconds } from '../lib/clip';
import { manName, reference } from '../lib/man';
import { releases, summary } from '../lib/news';
import { siteRoot } from '../lib/markdown';
import { releaseLink, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => `${base}${path}`;
const canonical = siteRoot();
const og = new URL('demo/og.png', canonical).href;
const github = 'https://github.com/ayagmar/niri-computer-use';
const { install, example } = home;

// The clip's real length and size, read when the site is built.
const clipPath = `clips/${example.clip}.mp4`;
const clipFile = readFileSync(join(process.cwd(), 'public', clipPath));
const clipFacts = `${Math.round(mp4Seconds(clipFile))} s, MP4, ${Math.round(clipFile.byteLength / 1000)} KB`;
const history = releases(changelog).slice(0, 3);
const released = history.find((release) => release.version === version);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<title>{home.title}</title>
		<meta name="description" content={home.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={link('sitemap-index.xml')} />
		<link rel="alternate" type="text/markdown" href={link('index.md')} />
		<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={home.title} />
		<meta property="og:description" content={home.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f7f5ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#10110f" media="(prefers-color-scheme: dark)" />
		<Slide />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<main id="main" class="workspace">
			<div class="strip">
				<div class="column man" tabindex="-1" role="region" aria-label="Manual page">
					<header class="running">
						<span>NIRI-COMPUTER-USE(1)</span>
						<span class="mid">User Commands</span>
						<span>NIRI-COMPUTER-USE(1)</span>
					</header>

					<div class="page" data-find>
						<section aria-labelledby="name">
							<p class="sh" aria-hidden="true">NAME</p>
							<h1 id="name"><b>niri-computer-use</b> - {home.name}</h1>
						</section>

						<section aria-labelledby="synopsis">
							<h2 id="synopsis"><a href="#synopsis">SYNOPSIS</a></h2>
							<p>
								<b>niri-computer-use</b>{' '}
								{home.commands.map((command, i) => <>{i > 0 && ' | '}<b>{command}</b></>)}
							</p>
						</section>

						<section aria-labelledby="description">
							<h2 id="description"><a href="#description">DESCRIPTION</a></h2>
							{home.about.map((paragraph) => <p>{paragraph}</p>)}
						</section>

						<section aria-labelledby="install">
							<h2 id="install"><a href="#install">INSTALLATION</a></h2>
							<p>Pipe the install script into sh:</p>
							<pre>{install.piped}</pre>
							<p>
								To read it first, open <a href={install.script}>install.sh</a>. Or build it, and use{' '}
								<u>~/.cargo/bin</u> below:
							</p>
							<pre>{install.cargo}</pre>
							<p>Bind the stop key in <u>config.kdl</u>:</p>
							<pre>{install.stop}</pre>
							<p>
								The script offers to register the server in each agent it supports that is on your PATH.
								The list, and the others: <a href={link('start/clients/')}>{reference(manName('start/clients'))}</a>.
							</p>
						</section>

						<section aria-labelledby="safety">
							<h2 id="safety"><a href="#safety">SAFETY</a></h2>
							<dl>
								{
									home.safety.map(([term, text]) => (
										<>
											<dt><b>{term}</b></dt>
											<dd>{text}</dd>
										</>
									))
								}
							</dl>
							<p>
								{home.sandbox} <a href={link('concepts/safety/')}>{reference(manName('concepts/safety'))}</a>.
							</p>
						</section>

						<section aria-labelledby="history">
							<h2 id="history"><a href="#history">HISTORY</a></h2>
							<table>
								<caption class="sr">The latest releases</caption>
								<tbody>
									{
										history.map((release) => (
											<tr>
												<td><a href={`${github}/releases/tag/v${release.version}`}>{release.version}</a></td>
												<td>{release.date}</td>
												<td>{summary(release)}</td>
											</tr>
										))
									}
								</tbody>
							</table>
							<p><a href={`${github}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a></p>
						</section>

						<section aria-labelledby="bugs">
							<h2 id="bugs"><a href="#bugs">BUGS</a></h2>
							<p>{home.bugs}</p>
						</section>

						<section aria-labelledby="see-also">
							<h2 id="see-also"><a href="#see-also">SEE ALSO</a></h2>
							<p class="refs">
								<a href="https://github.com/niri-wm/niri">niri(1)</a>,{' '}
								{home.seeAlso.map((id) => <><a href={link(`${id}/`)}>{reference(manName(id))}</a>, </>)}
								<a href={link('llms.txt')}>llms.txt</a>,{' '}
								<a href={github}>source</a>
							</p>
						</section>
					</div>

					<footer class="running foot">
						<a href={releaseLink}>niri-computer-use {version}</a>
						<span class="mid">{released?.date}</span>
						<span>NIRI-COMPUTER-USE(1)</span>
					</footer>

					<nav class="less" aria-label="Pager">
						<span class="prompt"><span class="wide">Manual page niri-computer-use(1)</span><span class="pct" aria-hidden="true"></span></span>
						<span class="msg" role="status"></span>
						<form class="find" hidden><label>/<input name="pattern" autocomplete="off" aria-label="Search the page" /></label></form>
						<a href="#install">install</a>
						<a href="#safety">safety</a>
						<a href="#example">example</a>
						<a href={link('start/install/')}>docs</a>
						<button type="button" data-help hidden>help</button>
					</nav>
				</div>

				<section class="column example" id="example" tabindex="-1" aria-labelledby="example-heading" data-find>
					<h2 id="example-heading"><a href="#example">EXAMPLE</a></h2>
					<figure>
						<a class="still" href={link(clipPath)} data-play>
							<Picture
								src={still}
								alt={example.alt}
								widths={[560, 900]}
								sizes="(min-width: 75rem) 760px, calc(100vw - 6ch)"
								formats={['avif']}
								fallbackFormat="jpg"
								quality={60}
								loading="eager"
								fetchpriority="high"
							/>
						</a>
						<figcaption>
							{example.caption} <a href={link(clipPath)} data-play>Play the clip</a> ({clipFacts}).
						</figcaption>
					</figure>
					<table class="calls">
						<caption class="sr">The session's calls: when each went out, in seconds into the clip, and its round trip</caption>
						<thead><tr><th scope="col">at</th><th scope="col">call</th><th scope="col">ms</th></tr></thead>
						<tbody>
							{
								example.calls.map(([start, call, ms]) => (
									<tr data-start={start} data-ms={ms}>
										<td>{start.toFixed(1)}</td>
										<td><code>{call}</code></td>
										<td>{ms}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</section>
			</div>
		</main>
		<Less columns find />
	</body>
</html>

<style is:global>
	/* The EXAMPLE column, and the replay's rows: calls still to come are dim, the one in
	   flight is in reverse video, and the ones made are in the bold ink. */
	figure {
		max-width: 70ch;
	}
	.still,
	.example video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		line-height: 0;
		border: 1px solid var(--ncu-rule);
		background: var(--ncu-plate);
	}
	.still img {
		display: block;
		width: 100%;
		height: auto;
	}
	figcaption {
		margin-top: 0.5em;
		color: var(--ncu-dim);
	}
	.calls th:first-child,
	.calls td:first-child,
	.calls th:last-child,
	.calls td:last-child {
		text-align: right;
	}
	.calls th:last-child,
	.calls td:last-child {
		padding-right: 0;
	}
	.calls tr {
		transition:
			color 0.15s,
			background-color 0.15s;
	}
	.calls [data-state='next'] {
		color: var(--ncu-dim);
	}
	.calls [data-state='done'] {
		color: var(--ncu-bold);
	}
	.calls [data-state='now'] {
		background: var(--ncu-ink);
		color: var(--ncu-ground);
	}
	.page {
		padding-top: 0;
	}
	.man > .running:first-child {
		padding-top: 1.5rem;
	}
	.example {
		padding: 0 2ch;
	}
	.example h2 {
		margin-top: 1.5em;
	}
	.less button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--ncu-ground);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}
	.less a,
	.less button {
		text-decoration-thickness: 1px;
	}

	/* Narrow: one column, EXAMPLE after the sections and before the running foot. */
	@media (max-width: 74.99rem) {
		.strip {
			display: flex;
			flex-direction: column;
		}
		.man {
			display: contents;
		}
		.example {
			order: 1;
			padding: 0;
		}
		.example > * {
			margin-left: calc(2ch + 7ch);
			margin-right: 2ch;
		}
		.example h2 {
			margin-left: 2ch;
		}
		.man > .foot {
			order: 2;
		}
		.man > .less {
			order: 3;
		}
	}
	@media (max-width: 40rem) {
		.example > * {
			margin-left: calc(1.5ch + 3ch);
			margin-right: 1.5ch;
		}
		.example h2 {
			margin-left: 1.5ch;
		}
		.calls td:nth-child(2) {
			white-space: normal;
		}
	}

	/* Wide: a niri workspace. Columns are windows on the backdrop with niri's 16 px gaps; the
	   focused one wears the amber ring and the others niri's inactive one. The strip slides
	   on niri's spring to keep the focused column in view. */
	@media (min-width: 75rem) {
		body {
			background: var(--ncu-plate);
		}
		/* The workspace clips the strip itself: on body, the clip would pass to the viewport
		   as hidden, and anything scrolled into view could shift the page sideways. */
		.workspace {
			container-type: inline-size;
			overflow-x: clip;
		}
		.strip {
			display: flex;
			align-items: flex-start;
			gap: 16px;
			width: max-content;
			padding: 16px 16px 0;
			transition: transform 0.4s var(--ncu-spring);
		}
		.column {
			background: var(--ncu-ground);
			outline: 4px solid var(--ncu-rule);
			outline-offset: 0;
			transition: outline-color 0.2s;
		}
		.man {
			width: 88ch;
		}
		.example {
			position: sticky;
			top: 16px;
			width: 50rem;
			max-height: calc(100dvh - 32px);
			overflow-y: auto;
			padding-bottom: 1.5rem;
		}
		.example figure,
		.example table {
			max-width: none;
			margin-left: 0;
		}
		.example table {
			width: 100%;
		}
		.man,
		:root[data-column='1'] .example,
		:root:not([data-column]) .strip:has(#example:target) .example {
			outline-color: var(--ncu-accent);
		}
		:root[data-column='1'] .man,
		:root:not([data-column]) .strip:has(#example:target) .man {
			outline-color: var(--ncu-rule);
		}
		:root[data-column='1'] .strip,
		:root:not([data-column]) .strip:has(#example:target) {
			transform: translateX(min(0px, calc(100cqw - 100%)));
		}
	}
	@media (min-width: 75rem) and (prefers-reduced-motion: reduce) {
		.strip,
		.column {
			transition: none;
		}
	}
</style>
