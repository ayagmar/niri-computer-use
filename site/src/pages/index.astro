---
// The home page, set as the server's manual page the way man shows it in a terminal
// (`styles/man.css`), in one flow: NAME and SYNOPSIS as a large opening with the install
// line, EXAMPLE as a band across the window where the clip and its calls sit as two niri
// windows, then the other sections with their names hanging in a left gutter. Dark or light
// follows the system. Without JavaScript it reads in full and the clip opens from a link;
// `scripts/less.ts` adds less's keys, the clip's replay and seeking from the call table. Its words are
// in `lib/home.ts`, which `pages/index.md.ts` serves as Markdown too.
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/man.css';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import Less from '../components/Less.astro';
import Slide from '../components/Slide.astro';
import still from '../assets/errand-still.jpg';
import changelog from '../../../CHANGELOG.md?raw';
import { home } from '../lib/home';
import { mp4Seconds } from '../lib/clip';
import { manName, reference } from '../lib/man';
import { history as latest, summary } from '../lib/news';
import { siteRoot } from '../lib/markdown';
import { releaseLink, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => `${base}${path}`;
const canonical = siteRoot();
const og = new URL('demo/og.png', canonical).href;
const github = 'https://github.com/ayagmar/niri-computer-use';
const { install, example } = home;

// The clip's real length and size, read when the site is built.
const clipPath = `clips/${example.clip}.mp4`;
const clipFile = readFileSync(join(process.cwd(), 'public', clipPath));
const clipFacts = `${Math.round(mp4Seconds(clipFile))} s, MP4, ${Math.round(clipFile.byteLength / 1000)} KB`;
const history = latest(changelog);
// The install line may break only after a slash, so the address never splits mid-word.
const pipedParts = install.piped.split('/');
const released = history.find((release) => release.version === version);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<title>{home.title}</title>
		<meta name="description" content={home.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
		<link rel="sitemap" href={link('sitemap-index.xml')} />
		<link rel="alternate" type="text/markdown" href={link('index.md')} />
		<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={home.title} />
		<meta property="og:description" content={home.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f7f5ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#10110f" media="(prefers-color-scheme: dark)" />
		<Slide />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="running wrap">
			<span>NIRI-COMPUTER-USE(1)</span>
			<span class="mid">User Commands</span>
			<span>NIRI-COMPUTER-USE(1)</span>
		</header>

		<main id="main" data-find>
			<section class="sec hero" aria-labelledby="name">
				<p class="sh" aria-hidden="true">NAME</p>
				<h1 id="name">
					<b class="mark">niri-computer-use</b>
					<span class="sr"> - </span>
					<span class="tag">{home.name}</span>
				</h1>
				<p class="sh" aria-hidden="true">SYNOPSIS</p>
				<p class="synopsis">
					<b>niri-computer-use</b>{' '}
					{home.commands.map((command, i) => <>{i > 0 && <span class="bar"> | </span>}<b>{command}</b></>)}
				</p>
				<pre class="oneliner piped">{pipedParts.map((part, i) => <>{i > 0 && <>/<wbr /></>}{part}</>)}</pre>
				<p class="facts">
					{home.about[1]} <a href="#install">Other ways to install</a> · <a href="#example">Watch it work</a>
				</p>
			</section>

			<section class="band" id="example" aria-labelledby="example-heading">
				<div class="band-in">
					<div class="band-head">
						<h2 id="example-heading"><a href="#example">EXAMPLE</a></h2>
						<p>{example.caption}</p>
					</div>
					<div class="windows">
						<figure class="win focused">
							<a class="still" href={link(clipPath)} data-play>
								<Picture
									src={still}
									alt={example.alt}
									widths={[560, 900, 1280]}
									sizes="(min-width: 75rem) 860px, calc(100vw - 3rem)"
									formats={['avif']}
									fallbackFormat="jpg"
									quality={60}
									loading="eager"
									fetchpriority="high"
								/>
								<span class="play" aria-hidden="true">
									<svg viewBox="0 0 10 12" width="10" height="12"><path d="M0 0v12l10-6z" fill="currentColor" /></svg>
									play
								</span>
							</a>
							<figcaption>
								<a href={link(clipPath)} data-play>Play the clip</a> ({clipFacts})
							</figcaption>
						</figure>
						<div class="win calls-win">
							<table class="calls">
								<caption class="sr">The session's calls: when each went out, in seconds into the clip, and its round trip</caption>
								<thead><tr><th scope="col">at</th><th scope="col">call</th><th scope="col">ms</th></tr></thead>
								<tbody>
									{
										example.calls.map(([start, call, ms]) => (
											<tr data-start={start} data-ms={ms}>
												<td>{start.toFixed(1)}</td>
												<td><code>{call}</code></td>
												<td>{ms}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="sec" aria-labelledby="description">
				<h2 id="description"><a href="#description">DESCRIPTION</a></h2>
				<p class="lead">
					{home.about[0].split(/(accepted|observed|changes)/).map((part, i) => (i % 2 ? <b>{part}</b> : part))}
				</p>
			</section>

			<section class="sec" aria-labelledby="safety">
				<h2 id="safety"><a href="#safety">SAFETY</a></h2>
				<dl class="guards">
					{
						home.safety.map(([term, text]) => (
							<div>
								<dt><b>{term}</b></dt>
								<dd>{text}</dd>
							</div>
						))
					}
				</dl>
				<p class="warn">
					{home.sandbox} <a href={link('concepts/safety/')}>{reference(manName('concepts/safety'))}</a>.
				</p>
			</section>

			<section class="sec" aria-labelledby="install">
				<h2 id="install"><a href="#install">INSTALLATION</a></h2>
				<p>Pipe the install script into sh:</p>
				<pre class="piped">{pipedParts.map((part, i) => <>{i > 0 && <>/<wbr /></>}{part}</>)}</pre>
				<p>
					To read it first, open <a href={install.script}>install.sh</a>. Or build it, and use{' '}
					<u>~/.cargo/bin</u> below:
				</p>
				<pre>{install.cargo}</pre>
				<p>Bind the stop key in <u>config.kdl</u>:</p>
				<pre>{install.stop}</pre>
				<p>
					The script offers to register the server in each agent it supports that is on your PATH.
					The list, and the others: <a href={link('start/clients/')}>{reference(manName('start/clients'))}</a>.
				</p>
			</section>

			<section class="sec" aria-labelledby="history">
				<h2 id="history"><a href="#history">HISTORY</a></h2>
				<table class="releases">
					<caption class="sr">The latest releases</caption>
					<tbody>
						{
							history.map((release) => (
								<tr>
									<td><a href={`${github}/releases/tag/v${release.version}`}>{release.version}</a></td>
									<td>{release.date}</td>
									<td>{summary(release)}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p><a href={`${github}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a></p>
			</section>

			<section class="sec" aria-labelledby="bugs">
				<h2 id="bugs"><a href="#bugs">BUGS</a></h2>
				<p>{home.bugs}</p>
			</section>

			<section class="sec" aria-labelledby="see-also">
				<h2 id="see-also"><a href="#see-also">SEE ALSO</a></h2>
				<p class="refs">
					<a href="https://github.com/niri-wm/niri">niri(1)</a>,{' '}
					{home.seeAlso.map((id) => <><a href={link(`${id}/`)}>{reference(manName(id))}</a>, </>)}
					<a href={link('llms.txt')}>llms.txt</a>,{' '}
					<a href={github}>source</a>
				</p>
			</section>
		</main>

		<footer class="running foot wrap">
			<a href={releaseLink}>niri-computer-use {version}</a>
			<span class="mid">{released?.date}</span>
			<span>NIRI-COMPUTER-USE(1)</span>
		</footer>

		<nav class="less" aria-label="Pager">
			<span class="prompt"><span class="wide">Manual page niri-computer-use(1)</span><span class="pct" aria-hidden="true"></span></span>
			<span class="msg" role="status"></span>
			<form class="find" hidden><label>/<input name="pattern" autocomplete="off" aria-label="Search the page" /></label></form>
			<a href="#example">example</a>
			<a href="#safety">safety</a>
			<a href="#install">install</a>
			<a href={link('start/install/')}>docs</a>
			<button type="button" data-help hidden>help</button>
		</nav>
		<Less find />
	</body>
</html>

<style is:global>
	/* One centred column. Section names hang in a gutter to the left of their text on wide
	   screens, and sit above it on narrow ones. */
	:root {
		--gutter: 16ch;
		--measure: 76ch;
	}
	@media (min-width: 64rem) {
		html {
			font-size: 17px;
		}
	}
	.wrap,
	.sec {
		width: min(100% - 4ch, var(--gutter) + var(--measure));
		margin-inline: auto;
		padding-inline: 0;
	}
	.running.wrap {
		padding-top: 1.5rem;
	}
	.sec {
		display: grid;
		grid-template-columns: var(--gutter) minmax(0, 1fr);
		align-items: baseline;
		margin-top: 4.5rem;
	}
	.sec > * {
		grid-column: 2;
		margin-left: 0;
	}
	.sec > :is(h2, .sh) {
		grid-column: 1;
		margin: 0;
	}
	.sec > :is(p, pre, dl, table) + :is(p, pre, dl, table) {
		margin-top: 1em;
	}

	/* The opening: the name at display size, then what it does, the commands and the line
	   to install it. */
	.hero {
		margin-top: clamp(3rem, 12vh, 8rem);
		row-gap: 0;
	}
	.hero .sh {
		color: var(--ncu-dim);
	}
	.hero h1 {
		margin: 0;
	}
	.mark {
		display: block;
		font-size: clamp(2.1rem, 6.4vw, 4.6rem);
		line-height: 1;
		letter-spacing: -0.03em;
		font-weight: 800;
		color: var(--ncu-bold);
	}
	.tag {
		display: block;
		margin-top: 1rem;
		font-size: clamp(1.05rem, 1.8vw, 1.35rem);
		line-height: 1.4;
		text-wrap: balance;
	}
	.hero .sh:nth-of-type(2),
	.synopsis {
		margin-top: 2.5rem;
	}
	.synopsis .bar {
		color: var(--ncu-dim);
	}
	.hero .oneliner {
		margin-top: 1.5rem;
		padding: 0.9em 1.5ch;
		outline: 1px solid var(--ncu-rule);
		outline-offset: -1px;
	}
	.hero .oneliner .copy {
		top: 0.9em;
		right: 0.5ch;
	}
	pre.oneliner:has(.copy) {
		padding-right: 8ch;
	}
	.facts {
		color: var(--ncu-dim);
	}
	.hero .facts {
		margin-top: 0.75rem;
	}

	/* EXAMPLE: a band across the window on the workspace's backdrop, where the clip and its
	   calls are two niri windows 16 px apart: the clip is focused, in the amber ring, and
	   the calls are in the inactive one. */
	.band {
		margin-top: 5.5rem;
		padding: 3rem 0 3.5rem;
		background: var(--ncu-plate);
		border-block: 1px solid var(--ncu-rule);
	}
	.band-in {
		width: min(100% - 3rem, 92rem);
		margin-inline: auto;
	}
	.band-head {
		display: grid;
		grid-template-columns: var(--gutter) minmax(0, var(--measure));
		align-items: baseline;
		width: min(100%, var(--gutter) + var(--measure));
		margin: 0 auto 2rem;
	}
	.band-head h2,
	.band-head p {
		margin: 0;
	}
	.band-head p {
		color: var(--ncu-dim);
	}
	.windows {
		display: grid;
		grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
		gap: 16px;
		align-items: stretch;
	}
	.win {
		margin: 0;
		background: var(--ncu-ground);
		outline: 4px solid var(--ncu-rule);
		transition: outline-color 0.2s;
	}
	.win.focused,
	.windows:has(.calls-win:hover, .calls-win:focus-within) .calls-win {
		outline-color: var(--ncu-accent);
	}
	.windows:has(.calls-win:hover, .calls-win:focus-within) .win.focused {
		outline-color: var(--ncu-rule);
	}
	.still,
	.win video {
		position: relative;
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		line-height: 0;
		background: var(--ncu-plate);
	}
	.still img {
		display: block;
		width: 100%;
		height: auto;
	}
	.play {
		position: absolute;
		left: 1.5ch;
		bottom: 1.5ch;
		display: inline-flex;
		align-items: center;
		gap: 1ch;
		padding: 0.35em 1.25ch;
		background: var(--ncu-ink);
		color: var(--ncu-ground);
		line-height: 1.55;
		transition:
			background-color 0.15s,
			color 0.15s;
	}
	.still:hover .play,
	.still:focus-visible .play {
		background: var(--ncu-bold);
		color: var(--ncu-ground);
	}
	figcaption {
		padding: 0.5em 1.5ch;
		border-top: 1px solid var(--ncu-rule);
		color: var(--ncu-dim);
	}
	.calls-win {
		overflow: auto;
	}
	.calls {
		width: 100%;
		margin: 0;
		font-size: 0.875rem;
	}
	.calls th,
	.calls td {
		padding: 0.3em 1.5ch;
	}
	.calls thead th {
		padding-block: 0.6em;
		border-bottom: 1px solid var(--ncu-rule);
	}
	.calls th:first-child,
	.calls td:first-child,
	.calls th:last-child,
	.calls td:last-child {
		text-align: right;
		white-space: nowrap;
	}
	.calls td:nth-child(2) code {
		overflow-wrap: anywhere;
	}
	.calls td:first-child button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--ncu-accent);
		cursor: pointer;
		text-decoration: underline dotted;
		text-underline-offset: 3px;
	}
	.calls tbody tr {
		transition:
			color 0.15s,
			background-color 0.15s;
	}
	.calls [data-state='next'] {
		color: var(--ncu-dim);
	}
	.calls [data-state='done'] {
		color: var(--ncu-bold);
	}
	.calls [data-state='now'],
	.calls [data-state='now'] button {
		background: var(--ncu-ink);
		color: var(--ncu-ground);
	}

	/* The rest of the manual. */
	.lead {
		font-size: 1.1rem;
		line-height: 1.6;
	}
	.guards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 3ch;
	}
	.guards dd {
		margin: 0.15em 0 0;
	}
	.warn {
		padding-top: 1em;
		border-top: 1px solid var(--ncu-rule);
	}
	.sec > .warn {
		margin-top: 1.5rem;
	}
	.releases td:first-child {
		white-space: nowrap;
	}
	.running.foot.wrap {
		margin: 6rem auto 0;
	}
	pre.piped {
		overflow-wrap: normal;
	}
	.less {
		padding-inline: max(2ch, (100% - var(--gutter) - var(--measure)) / 2);
	}
	.less button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--ncu-ground);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	/* niri opens the windows: as the band comes into view, the calls slide in beside the
	   clip on niri's spring. */
	@media (prefers-reduced-motion: no-preference) and (width > 64rem) {
		@supports (animation-timeline: view()) {
			.calls-win {
				animation: ncu-open linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 35%;
			}
			.win.focused {
				animation: ncu-shift linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 35%;
			}
		}
	}
	@keyframes ncu-open {
		from {
			opacity: 0.25;
			transform: translateX(12%) scale(0.96);
		}
	}
	@keyframes ncu-shift {
		from {
			transform: translateX(8%);
		}
	}

	/* Narrow: section names above their text, the windows stacked. */
	@media (max-width: 64rem) {
		.windows {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 48rem) {
		:root {
			--gutter: 0ch;
		}
		.sec,
		.band-head {
			grid-template-columns: minmax(0, 1fr);
		}
		.sec > :is(h2, .sh),
		.sec > * {
			grid-column: 1;
		}
		.sec > :not(h2, .sh) {
			margin-left: 3ch;
		}
		.sec > :is(h2, .sh) + * {
			margin-top: 0.5em;
		}
		.hero.sec > * {
			margin-left: 0;
		}
		.hero .sh {
			display: none;
		}
		.hero .synopsis {
			margin-top: 1.25rem;
		}
		.band-head p {
			margin-top: 0.5em;
		}
		.guards {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}
		.sec {
			margin-top: 3rem;
		}
	}
	@media (max-width: 40rem) {
		.play {
			left: 1ch;
			bottom: 1ch;
			padding: 0.1em 1ch;
			font-size: 0.8rem;
		}
		.band-in {
			width: calc(100% - 1.5rem);
		}
		.calls th,
		.calls td {
			padding-inline: 1ch;
		}
		.wrap,
		.sec {
			width: calc(100% - 3ch);
		}
	}
	@media print {
		.band {
			background: none;
		}
		.win {
			outline: 0;
		}
		.play {
			display: none;
		}
	}
</style>
