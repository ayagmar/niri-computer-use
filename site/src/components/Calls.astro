---
// A recording's calls as text: each call's time in the video, `→` the request and `←` a
// summary of the server's answer with its round trip. A line marked `$` is a command the user
// ran, and its `#` line says what it did. While the recording plays, the call it is showing
// wears a ring that moves down the list with it, and the calls still to come are dimmed.
// Each call's time plays the recording from there; a click anywhere on a call does the same.
// A screen reader hears the call's request with its time, and that the arrow keys move on.
import { at, type Demo } from '../lib/demo';

interface Props {
	demo: Demo;
	/** The list scrolls on its own, so it gets a name as a region. */
	scrolls?: boolean;
}

const { demo, scrolls = false } = Astro.props;
// The calls that hand the lease over, for the header's lease tag. The user's stop command
// takes it back too.
const lease = (request: string) =>
	request.startsWith('acquire_desktop')
		? 'held'
		: request.startsWith('release_desktop') || request === 'niri-computer-use stop'
			? 'free'
			: undefined;
---

<p class="sr-only" id={`${demo.name}-calls-keys`}>The arrow keys move between calls.</p>
<ol class="ncu-calls" data-calls={demo.name} aria-label={scrolls ? 'The calls' : undefined}>
	{
		demo.calls.map((call, index) => (
			<li class:list={{ error: call.error }} data-start={call.start} data-lease={lease(call.request)}>
				<button
					class="at"
					type="button"
					tabindex={index === 0 ? 0 : -1}
					aria-label={`Play from ${at(call.start)}`}
					aria-describedby={`${demo.name}-call-${index} ${demo.name}-calls-keys`}
				>
					{at(call.start)}
				</button>
				<code class="request" id={`${demo.name}-call-${index}`}>
					<span class="mark">{call.you ? '$' : '→'}</span> {call.request}
				</code>
				{call.you ? (
					<code class="answer narration">
						<span class="mark">#</span> {call.answer}
					</code>
				) : (
					<code class="answer">
						<span class="mark">←</span> {call.answer} <span class="ms">{call.ms} ms</span>
					</code>
				)}
			</li>
		))
	}
</ol>

<style>
	.ncu-calls {
		position: relative;
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.25rem;
	}

	li {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		column-gap: 0.75rem;
		padding: 0.3rem 0.5rem;
		border-radius: 6px;
		cursor: pointer;
		transition: background-color 150ms ease;
	}

	li :is(.request, .answer, .answer .ms) {
		transition: color 200ms ease-out;
	}

	li[data-state='next'] :is(.request, .answer, .answer .ms) {
		color: var(--sl-color-gray-3);
	}

	/* The ring on the call being shown, moved from call to call by the recording's script. */
	.ncu-calls :global(.ncu-now) {
		position: absolute;
		inset: 0;
		border: 1px solid var(--ncu-ring);
		border-radius: 6px;
		pointer-events: none;
	}

	.at {
		grid-row: span 2;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		line-height: 1.75;
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
		cursor: pointer;
	}

	@media (hover: hover) {
		li:hover {
			background: var(--sl-color-gray-6);
		}

		li:hover .at {
			color: var(--sl-color-white);
		}
	}

	code {
		display: block;
		padding: 0 0 0 1.5ch;
		text-indent: -1.5ch;
		overflow-wrap: anywhere;
		background: none;
		font-size: 0.75rem;
		line-height: 1.6;
	}

	/* On a phone the calls are a step larger, so they read without zooming. */
	@media (max-width: 50rem) {
		code {
			font-size: 0.8125rem;
		}

		.at {
			font-size: 0.75rem;
			line-height: 1.8;
		}
	}

	.request {
		color: var(--sl-color-white);
	}

	.answer {
		color: var(--sl-color-gray-2);
	}

	.mark {
		color: var(--ncu-ring);
	}

	.error .answer,
	.error .answer .mark {
		color: var(--ncu-stop);
	}

	.ms::before {
		content: '· ';
	}

	.ms {
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	/* What the scene says about a user command, which prints nothing: not the server's. */
	.narration,
	.narration .mark {
		color: var(--sl-color-gray-3);
	}
</style>
