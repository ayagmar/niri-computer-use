---
// One section of the home page, drawn as a niri workspace: its windows sit side by side as
// columns on a wide screen and slide in from the right as they scroll into view there. While the
// section crosses the middle of the view, the page's focus ring (FocusRing.astro) moves to
// its focused column and its pill in the header's bar is lit, the way niri marks the window
// and workspace you moved to.
import { workspaces } from '../lib/workspaces.mjs';

interface Props {
	/** The anchor, one of the workspaces in `src/lib/workspaces.mjs`. */
	id: string;
}

const { id } = Astro.props;
if (!workspaces.some((workspace) => workspace.id === id)) {
	throw new Error(`Workspace ${id} is not listed in src/lib/workspaces.mjs`);
}
---

<section class="ncu-ws" id={id} data-workspace={id}>
	<slot />
</section>

<style>
	.ncu-ws {
		padding-block: clamp(3rem, 2rem + 3vw, 5rem);
		border-top: 1px solid var(--ncu-rule);
	}

	.ncu-ws :global(h2) {
		margin: 0;
		max-width: 40rem;
		font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.6rem);
		line-height: 1.08;
		font-weight: 660;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	/* Starlight wraps each h2 in a .sl-heading-wrapper. */
	.ncu-ws :global(:is(h2, .sl-heading-wrapper) + p) {
		max-width: 40rem;
		color: var(--sl-color-gray-2);
	}

	/* Columns: side by side when there's room, with niri's gaps. */
	.ncu-ws :global(.columns) {
		display: grid;
		gap: var(--ncu-gap);
		margin-top: 2rem;
	}

	@media (min-width: 50rem) {
		.ncu-ws :global(.columns) {
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		}

		.ncu-ws :global(.columns.wide-first) {
			grid-template-columns: minmax(0, 3fr) minmax(15rem, 2fr);
		}

		.ncu-ws :global(.columns.wide-last) {
			grid-template-columns: minmax(15rem, 2fr) minmax(0, 3fr);
		}

		/* A window as tall as its content, as niri sizes a window that asks for less. */
		.ncu-ws :global(:is(.wide-first, .wide-last) > .column) {
			align-self: start;
		}
	}

	/* A long list in a wide column reads in two. */
	@media (min-width: 72rem) {
		.ncu-ws :global(.split ul) {
			columns: 2;
			column-gap: 2rem;
		}

		.ncu-ws :global(.split li) {
			break-inside: avoid;
		}
	}

	.ncu-ws :global(.column) {
		position: relative;
		min-width: 0;
		margin: 0;
		padding: clamp(1rem, 0.75rem + 0.8vw, 1.25rem);
		border: 1px solid var(--ncu-rule);
		border-radius: var(--ncu-radius);
		background: var(--ncu-panel);
	}

	.ncu-ws :global(.column > :first-child) {
		margin-top: 0;
	}

	/* Side by side, a section's columns arrive from the right as they scroll into view, as
	   niri scrolls a row of columns in, and are in place by the time they are a third of the
	   way up the view. Stacked on a phone they stay still. */
	@supports (animation-timeline: view()) {
		@media (min-width: 50rem) and (prefers-reduced-motion: no-preference) {
			.ncu-ws :global(.column) {
				animation: ncu-arrive cubic-bezier(0.16, 1, 0.3, 1) both;
				animation-timeline: view();
				animation-range: entry 0% entry 33vh;
			}
		}
	}

	@keyframes ncu-arrive {
		from {
			translate: 3rem 0;
		}
	}
</style>
