---
// A demo recording in a column: the plate, the call the recording is about with its answer,
// the prompt, and every call as text under a disclosure.
import { loadDemo } from '../lib/demo';
import Calls from './Calls.astro';
import Recording from './Recording.astro';

interface Props {
	name: string;
	/** What the recording shows, for screen readers. */
	label: string;
	/** The call to show under the recording, by its place in the calls. */
	call?: number;
}

const { name, label, call: index = 0 } = Astro.props;
const demo = await loadDemo(name, [480, 800]);
const call = demo.calls[index];
---

<figure class="ncu-demo not-content">
	<Recording demo={demo} label={label} sizes="(min-width: 50rem) 24rem, 92vw" />
	<figcaption>
		<p class="asked"><span>asked</span> {demo.prompt}</p>
		{
			call && (
				<p class:list={['call', { error: call.error }]}>
					<code>
						<span class="mark">→</span> {call.request}
					</code>
					<code class="answer">
						<span class="mark">←</span> {call.answer}
					</code>
				</p>
			)
		}
		{demo.note && <p class="note">{demo.note}</p>}
	</figcaption>
	<details>
		<summary>All {demo.calls.length} calls as text</summary>
		<Calls demo={demo} />
	</details>
</figure>

<style>
	.ncu-demo {
		margin: 1rem 0 0;
		min-width: 0;
	}

	figcaption {
		margin-top: 0.9rem;
	}

	.asked {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.asked span {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-inline-end: 0.35rem;
	}

	.call {
		margin-top: 0.6rem;
	}

	.call code {
		display: block;
		padding: 0 0 0 1.5ch;
		text-indent: -1.5ch;
		overflow-wrap: anywhere;
		background: none;
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--sl-color-white);
	}

	.call .answer {
		color: var(--sl-color-gray-2);
	}

	@media (max-width: 50rem) {
		.call code {
			font-size: 0.8125rem;
		}
	}

	.mark {
		color: var(--ncu-ring);
	}

	.error .answer,
	.error .answer .mark {
		color: var(--ncu-stop);
	}

	details {
		margin-top: 0.25rem;
		font-size: var(--sl-text-sm);
	}

	/* The toggle is a full 44px tall to tap; its padding keeps the text where it was. */
	summary {
		padding-block: 0.8rem;
		cursor: pointer;
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		transition: color 150ms ease;
	}

	summary:hover {
		color: var(--sl-color-white);
	}

	/* The list opens to its height rather than appearing at once. */
	@media (prefers-reduced-motion: no-preference) {
		details {
			interpolate-size: allow-keywords;
		}

		details::details-content {
			height: 0;
			overflow: clip;
			transition:
				height 360ms cubic-bezier(0.16, 1, 0.3, 1),
				content-visibility 360ms allow-discrete;
		}

		details[open]::details-content {
			height: auto;
		}
	}

	details :global(.ncu-calls) {
		margin-top: 0.25rem;
	}

	.note {
		margin-top: 0.6rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
</style>
