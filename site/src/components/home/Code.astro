---
// A command to copy: the text as it is, wrapped to the width, and a button that copies it.
interface Props {
	code: string;
	lang: string;
}

const { code, lang } = Astro.props;
---

<div class="code" data-code>
	<pre data-lang={lang}><code>{code}</code></pre>
	<button type="button" data-copy>Copy</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			const code = button.parentElement!.querySelector('code')!.textContent ?? '';
			try {
				await navigator.clipboard.writeText(code);
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Select it';
			}
			setTimeout(() => (button.textContent = 'Copy'), 1600);
		});
	}
</script>

<style>
	.code {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: 0.5rem;
		padding: 0.35rem 0.35rem 0.35rem 1rem;
		border-radius: 3px;
		background: var(--plate);
		color: var(--plate-ink);
	}

	pre {
		margin: 0;
		padding-block: 0.65rem;
		font: 0.8125rem/1.6 var(--mono);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	pre code {
		font: inherit;
	}

	button {
		min-width: 4.5rem;
		min-height: 2.75rem;
		padding: 0 0.9rem;
		border: 1px solid var(--plate-rule);
		border-radius: 3px;
		background: transparent;
		color: var(--plate-ink);
		font: 600 0.8125rem/1 var(--sans);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			transform 140ms var(--ease);
	}

	button:hover {
		background: var(--plate-rule);
	}

	button:active {
		transform: scale(0.96);
	}

	button:focus-visible {
		outline-color: var(--plate-ink);
	}

	/* Without the script there is nothing to copy with; the text stays selectable. */
	:global(html:not(.js)) button {
		display: none;
	}
</style>
