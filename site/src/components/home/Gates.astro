---
// The checks an action passes on its way to niri, as a block diagram and a table. Picking a
// row sends an action through the diagram and stops it at the check that refuses it.
interface Gate {
	gate: string;
	when: string;
	covers: string;
	error: string;
	detail: string;
}

interface Props {
	items: Gate[];
	pass: { text: string; answer: string };
	note: string;
}

const { items, pass, note } = Astro.props;
const quoted = (text: string) => text.replace(/`/g, '');
---

<div class="gates" data-gates>
	<div class="flow" data-flow>
		<div class="node agent" data-node="agent">
			<b>Agent</b>
			<span>Claude Code, Codex, Pi</span>
		</div>
		<div class="wire"><span>MCP, stdio</span></div>
		<div class="engine">
			<p class="title">niri-computer-use</p>
			<ol class="checks">
				{
					items.map((item, index) => (
						<li class="check" data-node={`gate-${index}`}>
							<b>{item.gate}</b>
							{index === 0 && <span class="you">set by your stop key</span>}
						</li>
					))
				}
			</ol>
			<p class="audit">Every call that reaches a tool is written to the audit log.</p>
		</div>
		<div class="wire"><span>IPC, input</span></div>
		<div class="node niri" data-node="niri">
			<b>niri</b>
			<span>its IPC and event stream, virtual pointer and keyboard, AT-SPI, Noctalia</span>
		</div>
		<span class="packet" data-packet aria-hidden="true"></span>
	</div>
	<output class="answer" data-answer>
		<span>Pick a row below to send an action through the checks.</span>
	</output>
	<div class="table">
		<table>
			<caption><b>Table 1.</b> When an action is refused. {note}</caption>
			<thead>
				<tr><th scope="col">Check</th><th scope="col">Refused when</th><th scope="col">Applies to</th><th scope="col">The agent gets</th></tr>
			</thead>
			<tbody>
				{
					items.map((item, index) => (
						<tr data-row={index}>
							<th scope="row">
								<button type="button" data-run={index} data-error={item.error} data-detail={quoted(item.detail)}>
									{item.gate}
								</button>
							</th>
							<td>{item.when}</td>
							<td>{item.covers}</td>
							<td>
								<code class="err">{item.error}</code>
								<code class="detail">{quoted(item.detail)}</code>
							</td>
						</tr>
					))
				}
				<tr data-row={items.length}>
					<th scope="row">
						<button type="button" data-run={items.length} data-answer={pass.answer}>
							{pass.text}
						</button>
					</th>
					<td>Nothing above applies.</td>
					<td>every action</td>
					<td>
						<code>{pass.answer}</code>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)');
	const HOP = 260;

	for (const root of document.querySelectorAll<HTMLElement>('[data-gates]')) {
		const flow = root.querySelector<HTMLElement>('[data-flow]')!;
		const packet = root.querySelector<HTMLElement>('[data-packet]')!;
		const answer = root.querySelector<HTMLOutputElement>('[data-answer]')!;
		const checks = [...root.querySelectorAll<HTMLElement>('.check')];
		const niri = root.querySelector<HTMLElement>('[data-node="niri"]')!;
		const agent = root.querySelector<HTMLElement>('[data-node="agent"]')!;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-run]')];
		let running: Animation | null = null;

		// The action runs along the wires and over the checks' top edges (their left edges
		// when the diagram stands upright), so it never covers their names.
		const point = (node: HTMLElement) => {
			const box = node.getBoundingClientRect();
			const outer = flow.getBoundingClientRect();
			const across = niri.getBoundingClientRect().left > agent.getBoundingClientRect().right;
			const check = node.classList.contains('check');
			return {
				x: box.left - outer.left + (check && !across ? 0 : box.width / 2),
				y: box.top - outer.top + (check && across ? 0 : box.height / 2),
			};
		};

		const say = (button: HTMLButtonElement) => {
			const refused = button.dataset.error;
			const lines = refused
				? [`← refused: ${refused}`, button.dataset.detail!]
				: [`← ${button.dataset.answer}`];
			answer.dataset.kind = refused ? 'error' : 'pass';
			answer.replaceChildren(
				...lines.map((line) => Object.assign(document.createElement('code'), { textContent: line })),
			);
		};

		const run = (index: number) => {
			const button = buttons[index];
			const stopAt = index < checks.length ? index : -1;
			buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
			root.querySelectorAll('tr[data-row]').forEach((row, other) => row.classList.toggle('on', other === index));
			checks.forEach((check) => check.classList.remove('ok', 'no'));
			niri.classList.remove('ok');
			running?.cancel();
			const path = [agent, ...(stopAt === -1 ? checks : checks.slice(0, stopAt + 1)), ...(stopAt === -1 ? [niri] : [])];
			const finish = () => {
				checks.forEach((check, other) => {
					if (stopAt === -1 || other < stopAt) check.classList.add('ok');
				});
				if (stopAt >= 0) {
					checks[stopAt].classList.add('no');
					if (!reduce.matches) checks[stopAt].animate(
						[0, -5, 5, -4, 4, -2, 0].map((dx) => ({ transform: `translateX(${dx}px)` })),
						{ duration: 420, easing: 'ease-out' },
					);
				} else niri.classList.add('ok');
				say(button);
			};
			if (reduce.matches) {
				packet.style.opacity = '0';
				finish();
				return;
			}
			answer.dataset.kind = '';
			answer.replaceChildren(Object.assign(document.createElement('code'), { textContent: '→ action' }));
			const points = path.map(point);
			running = packet.animate(
				points.map((point, step) => ({
					transform: `translate(${point.x}px, ${point.y}px)`,
					opacity: step === 0 ? 0 : 1,
					offset: step / (points.length - 1),
				})),
				{ duration: HOP * (points.length - 1), easing: 'linear', fill: 'forwards' },
			);
			// Each check lights up as the action passes it.
			path.slice(1).forEach((node, step) => {
				setTimeout(() => {
					if (node.classList.contains('check') && node !== checks[stopAt]) node.classList.add('ok');
				}, HOP * (step + 1));
			});
			running.finished.then(finish, () => {});
		};

		buttons.forEach((button, index) => button.addEventListener('click', () => run(index)));

		// Once in view: one action that passes, then one the stop flag refuses.
		const seen = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			seen.disconnect();
			run(buttons.length - 1);
			if (!reduce.matches) setTimeout(() => run(0), HOP * (checks.length + 2) + 1400);
		}, { threshold: 0.5 });
		seen.observe(flow);
	}
</script>

<style>
	.flow {
		position: relative;
		display: grid;
		grid-template-columns: minmax(8rem, 0.8fr) 5.5rem minmax(0, 3.2fr) 5.5rem minmax(9rem, 1fr);
		align-items: center;
	}

	.node,
	.engine {
		border: 1px solid var(--ink);
		background: var(--paper);
		border-radius: 3px;
	}

	.node {
		display: grid;
		gap: 0.2rem;
		padding: 0.8rem 0.9rem;
		font-size: 0.8125rem;
		line-height: 1.35;
		color: var(--ink-2);
		transition: background-color 240ms var(--ease), color 240ms var(--ease);
	}

	.node b {
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
	}

	.node.niri:global(.ok) {
		background: var(--ink);
		color: var(--paper);
	}

	.node.niri:global(.ok) b {
		color: var(--paper);
	}

	.wire {
		position: relative;
		align-self: stretch;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wire::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		border-top: 1.5px solid var(--ink);
	}

	.wire::after {
		content: '';
		position: absolute;
		right: 0;
		top: calc(50% - 4px);
		border: 4px solid transparent;
		border-left: 7px solid var(--ink);
		border-right: 0;
	}

	.wire span {
		position: relative;
		top: -0.95rem;
		font: 0.6875rem/1.2 var(--mono);
		color: var(--ink-2);
		text-align: center;
	}

	.engine {
		padding: 0.7rem 0.9rem 0.8rem;
	}

	.title {
		font-weight: 700;
		font-size: 0.9375rem;
	}

	.checks {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.6rem;
		list-style: none;
		padding: 0;
		margin: 0.7rem 0;
	}

	/* The path the action takes through the checks. */
	.checks::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		border-top: 1.5px dashed var(--rule);
	}

	.check {
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.25rem;
		min-height: 4.4rem;
		padding: 0.55rem 0.6rem;
		border: 1px solid var(--ink);
		border-radius: 3px;
		background: var(--paper);
		font-size: 0.8125rem;
		line-height: 1.3;
		transition: background-color 200ms var(--ease), color 200ms var(--ease), border-color 200ms var(--ease);
	}

	.check b {
		font-weight: 650;
	}

	.check .you {
		font-size: 0.75rem;
		color: var(--red);
	}

	.check:global(.ok) {
		background: var(--ink);
		color: var(--paper);
	}

	.check:global(.ok) .you {
		color: inherit;
	}

	.check:global(.no) {
		background: var(--red);
		border-color: var(--red);
		color: #fff;
	}

	.check:global(.no) .you {
		color: #fff;
	}

	.audit {
		font-size: 0.75rem;
		color: var(--ink-2);
	}

	.packet {
		position: absolute;
		left: -0.4rem;
		top: -0.4rem;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		background: var(--mark-strong);
		border: 2px solid var(--ink);
		opacity: 0;
		pointer-events: none;
		z-index: 3;
	}

	:global(html:not(.js)) .answer {
		display: none;
	}

	.answer {
		display: block;
		min-height: 3.4rem;
		margin-top: 1rem;
		padding: 0.55rem 0.75rem;
		background: var(--mark);
		font: 0.8125rem/1.55 var(--mono);
		overflow-wrap: anywhere;
	}

	.answer :global(code) {
		display: block;
		font: inherit;
	}

	.answer[data-kind='error'] :global(code:first-child) {
		color: var(--red);
	}

	.answer > span {
		font-family: var(--sans);
		color: var(--ink-2);
	}

	.table {
		margin-top: 1.5rem;
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		line-height: 1.45;
	}

	caption {
		text-align: left;
		padding-bottom: 0.6rem;
		color: var(--ink-2);
	}

	caption b {
		color: var(--ink);
		font-weight: 650;
	}

	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: 0.55rem 1rem 0.55rem 0;
		border-bottom: 1px solid var(--rule);
	}

	thead th {
		font-size: 0.6875rem;
		font-weight: 650;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-2);
		border-bottom: 1px solid var(--ink);
	}

	tbody th {
		padding-top: 0.2rem;
		padding-bottom: 0.2rem;
	}

	tr:global(.on) td,
	tr:global(.on) th {
		background: var(--mark);
	}

	button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		padding: 0 0.3rem;
		border: 0;
		background: none;
		color: var(--ink);
		font: 650 0.875rem/1.2 var(--sans);
		text-align: left;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		cursor: pointer;
	}

	button:hover {
		text-decoration-thickness: 2px;
	}

	td code {
		display: block;
		font: 0.75rem/1.5 var(--mono);
		overflow-wrap: anywhere;
	}

	.err {
		font-weight: 600;
	}

	.detail {
		color: var(--ink-2);
	}

	@media (max-width: 60rem) {
		.flow {
			grid-template-columns: minmax(0, 1fr);
		}

		.wire {
			height: 3rem;
		}

		.wire::before {
			left: 50%;
			right: auto;
			top: 0;
			bottom: 0;
			border-top: 0;
			border-left: 1.5px solid var(--ink);
		}

		.wire::after {
			right: auto;
			left: calc(50% - 4px);
			top: auto;
			bottom: 0;
			border: 4px solid transparent;
			border-top: 7px solid var(--ink);
			border-bottom: 0;
		}

		.wire span {
			top: 0;
			left: 1.6rem;
			text-align: left;
		}

		.checks {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.4rem;
		}

		.checks::before {
			left: 0;
			right: auto;
			top: 0;
			bottom: 0;
			border-top: 0;
			border-left: 1.5px dashed var(--rule);
		}

		.check {
			min-height: 0;
			grid-template-columns: auto 1fr;
			align-items: baseline;
			gap: 0.6rem;
		}

		table,
		thead,
		tbody,
		tr,
		th,
		td {
			display: block;
		}

		thead {
			display: none;
		}

		tr {
			padding: 0.4rem 0 0.7rem;
			border-bottom: 1px solid var(--rule);
		}

		th,
		td {
			border: 0;
			padding: 0.1rem 0;
		}
	}
</style>
