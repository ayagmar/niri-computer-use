---
// 88×31 buttons for the projects this one stands on, each a link to it.
import { version } from '../../lib/version';

const github = 'https://github.com/ayagmar/niri-computer-use';
const buttons = [
	{ href: 'https://github.com/niri-wm/niri', top: 'niri', bottom: '26.04', tone: 'niri' },
	{ href: 'https://github.com/noctalia-dev/noctalia-shell', top: 'Noctalia', bottom: 'shell', tone: 'noct' },
	{ href: 'https://wayland.freedesktop.org/', top: 'Wayland', bottom: 'only', tone: 'way' },
	{ href: 'https://modelcontextprotocol.io/', top: 'MCP', bottom: 'over stdio', tone: 'mcp' },
	{ href: 'https://crates.io/crates/niri-computer-use', top: 'crates.io', bottom: version, tone: 'crate' },
	{ href: `${github}/blob/main/LICENSE`, top: 'MIT', bottom: 'licence', tone: 'mit' },
];
---

<ul class="buttons">
	{
		buttons.map((b) => (
			<li>
				<a class={`b88 ${b.tone}`} href={b.href}>
					<span class="t">{b.top}</span>
					<span class="s">{b.bottom}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.buttons {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.b88 {
		display: flex;
		flex-direction: column;
		justify-content: center;
		box-sizing: border-box;
		width: 88px;
		height: 31px;
		border: 1px solid #000;
		box-shadow: inset 1px 1px 0 rgb(255 255 255 / 0.55), inset -1px -1px 0 rgb(0 0 0 / 0.45);
		color: #fff;
		font: 700 11px/1.05 Verdana, 'DejaVu Sans', sans-serif;
		text-align: center;
		text-decoration: none;
	}
	.b88:visited {
		color: #fff;
	}
	.b88 .s {
		font-weight: 400;
		font-size: 9px;
		color: #ffe9a8;
	}
	.b88:hover .t {
		text-decoration: underline;
	}
	.b88:active {
		box-shadow: inset -1px -1px 0 rgb(255 255 255 / 0.55), inset 1px 1px 0 rgb(0 0 0 / 0.45);
	}
	.b88:focus-visible {
		outline: 2px dotted #000;
		outline-offset: 2px;
	}
	.niri { background: #7a4a00; }
	.noct { background: #2e2860; }
	.way { background: #00466e; }
	.mcp { background: #222; }
	.crate { background: #2f5200; }
	.mit { background: #800000; }
</style>
