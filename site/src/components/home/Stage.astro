---
// A recording on its black plate, with its calls as subtitles under it: the call the video
// shows, its answer and who holds the lease, following the video's real call times. Before it
// plays, the still is the recording's last frame, so the subtitle is its last call. The full
// list of calls is in a disclosure under it, which is also where the subtitles come from.
//
// On a phone a recording can show half the desktop's width, where the agent works, so it stays
// legible: its still is cut to that half, and the video is drawn at twice the width and moved
// so the same half shows.
import { CROP_LEFT, STILL_WIDTHS, at, leaseAfter, loadDemo, type Crop } from '../../lib/demo';

interface Props {
	name: string;
	label: string;
	crop?: Crop;
	sizes: string;
	note?: string;
}

const { name, label, crop, sizes, note } = Astro.props;
const demo = await loadDemo(name, STILL_WIDTHS, crop);
const lease = leaseAfter(demo.calls);
const last = demo.calls.at(-1)!;
---

<figure class="stage" data-stage data-crop={crop && ''} style={crop && `--crop: ${CROP_LEFT[crop]}`}>
	<div class="frame" data-frame>
		<picture>
			{demo.cropped && <source media="(max-width: 47.99rem)" srcset={demo.cropped} sizes="100vw" />}
			<img
				src={demo.poster.src}
				srcset={demo.poster.srcset}
				sizes={sizes}
				width={demo.width}
				height={demo.height}
				alt=""
				loading="lazy"
				decoding="async"
			/>
		</picture>
		<video
			muted
			loop
			playsinline
			preload="none"
			aria-label={label}
			data-webm={demo.webm}
			data-mp4={demo.mp4}
			width={demo.width}
			height={demo.height}></video>
	</div>
	<div class="bar">
		<p class="ask">“{demo.prompt}”</p>
		<p class="lease" data-lease={lease.at(-1)}>{`lease ${lease.at(-1)}`}</p>
		<div class="sub" data-sub aria-hidden="true" data-error={last.error ? '' : undefined}>
			<code class="req">{last.you ? '$ ' : '→ '}{last.request}</code>
			<code class="ans">{last.you ? '# ' : '← '}{last.answer}{last.ms !== null && <span> · {last.ms} ms</span>}</code>
		</div>
		<button class="toggle" type="button" data-toggle aria-label={`Play the recording: ${label}`}>Play</button>
	</div>
	<figcaption>
		{note && <p class="note">{note}</p>}
		<details>
			<summary>All {demo.calls.length} calls</summary>
			<ol>
				{
					demo.calls.map((call, index) => (
						<li
							data-start={call.start}
							data-lease={lease[index]}
							data-error={call.error ? '' : undefined}
							data-you={call.you ? '' : undefined}>
							<span class="time">{at(call.start)}</span>
							<code class="req">
								{call.you ? '$ ' : '→ '}
								{call.request}
							</code>
							<code class="ans">
								{call.you ? '# ' : '← '}
								{call.answer}
								{call.ms !== null && <span> · {call.ms} ms</span>}
							</code>
						</li>
					))
				}
			</ol>
		</details>
	</figcaption>
</figure>

<script>
	// Each recording loads once the page has, plays while a third of it is in view, and drives
	// its subtitles and lease tag from the call list. Reduced motion and Save-Data leave it
	// still until its Play button is pressed.
	const still =
		matchMedia('(prefers-reduced-motion: reduce)').matches ||
		(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	const loaded = new Promise((resolve) => {
		if (document.readyState === 'complete') resolve(null);
		else addEventListener('load', resolve, { once: true });
	});

	for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
		const video = stage.querySelector('video')!;
		const toggle = stage.querySelector<HTMLButtonElement>('[data-toggle]')!;
		const sub = stage.querySelector<HTMLElement>('[data-sub]')!;
		const lease = stage.querySelector<HTMLElement>('[data-lease]')!;
		const calls = [...stage.querySelectorAll<HTMLLIElement>('li[data-start]')];
		const label = video.getAttribute('aria-label');
		let wanted = !still;
		let inView = false;
		let shown = calls.length - 1;

		const load = () => {
			if (video.childElementCount > 0) return;
			const sources: [string, string | undefined][] = [
				['video/webm; codecs="av01.0.12M.08"', video.dataset.webm],
				['video/mp4', video.dataset.mp4],
			];
			for (const [type, src] of sources) {
				const source = document.createElement('source');
				source.type = type;
				source.src = src!;
				video.append(source);
			}
			video.load();
		};
		const play = () => {
			load();
			video.play().catch(() => {});
		};
		const show = (index: number) => {
			const call = calls[index];
			shown = index;
			sub.replaceChildren(...[...call.querySelectorAll('code')].map((code) => code.cloneNode(true)));
			sub.toggleAttribute('data-error', call.hasAttribute('data-error'));
			lease.dataset.lease = call.dataset.lease;
			lease.textContent = `lease ${call.dataset.lease}`;
			stage.dispatchEvent(new CustomEvent('ncu-call', { detail: call }));
			if (!still) {
				sub.animate([{ transform: 'translateY(0.6em)', opacity: 0 }, { transform: 'none', opacity: 1 }], {
					duration: 260,
					easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
				});
			}
		};

		video.addEventListener('timeupdate', () => {
			const t = video.currentTime;
			const index = Math.max(0, calls.findLastIndex((call) => Number(call.dataset.start) <= t));
			if (index !== shown) show(index);
		});
		video.addEventListener('playing', () => stage.setAttribute('data-playing', ''));
		video.addEventListener('pause', () => stage.removeAttribute('data-playing'));
		for (const type of ['play', 'pause']) {
			video.addEventListener(type, () => {
				const paused = video.paused;
				toggle.textContent = paused ? 'Play' : 'Pause';
				toggle.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} the recording: ${label}`);
			});
		}
		toggle.addEventListener('click', () => {
			wanted = video.paused;
			if (wanted) play();
			else video.pause();
		});
		stage.addEventListener('ncu-seek', (event) => {
			wanted = true;
			load();
			video.currentTime = (event as CustomEvent<number>).detail;
			play();
		});

		new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				if (!inView) video.pause();
				else if (wanted) loaded.then(() => inView && wanted && play());
			},
			{ threshold: 0.35 },
		).observe(stage.querySelector('[data-frame]')!);
	}
</script>

<style>
	.stage {
		margin: 0;
		background: var(--ncu-plate);
		color: var(--ncu-plate-ink);
	}

	.frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--ncu-plate);
	}

	/* The video and its still, its caption band below the frame's edge. */
	.frame :is(img, video) {
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		height: auto;
		display: block;
	}

	video {
		opacity: 0;
		transition: opacity 400ms var(--ncu-ease);
	}

	[data-playing] video {
		opacity: 1;
	}

	@media (max-width: 47.99rem) {
		[data-crop] .frame {
			aspect-ratio: 8 / 9;
		}

		[data-crop] video {
			width: 200%;
			translate: calc(var(--crop) * -100%) 0;
		}
	}

	.bar {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.5rem 1rem;
		padding: 0.9rem clamp(1rem, 3vw, 2.5rem) 1.1rem;
	}

	.ask {
		grid-column: 1;
		align-self: center;
		margin: 0;
		color: var(--ncu-plate-ink-2);
		font-size: 1rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.lease {
		grid-column: 2;
		grid-row: 2;
		justify-self: end;
		align-self: start;
		margin: 0;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--ncu-plate-ink-2);
		background: var(--ncu-plate-raised);
		transition:
			background-color 200ms ease,
			color 200ms ease;
	}

	.lease[data-lease='held'] {
		color: var(--ncu-plate);
		background: var(--ncu-plate-ink);
	}

	.lease[data-lease='stopped'] {
		color: #fff;
		background: var(--ncu-red);
	}

	/* Three lines whatever the call, so the bar keeps its height as the calls change: the
	   request on one, its answer on two. */
	.sub {
		grid-column: 1;
		grid-row: 2;
		height: 4.35em;
		overflow: hidden;
		font-size: clamp(0.875rem, 0.7rem + 0.6vw, 1.25rem);
		line-height: 1.45;
	}

	.sub code,
	li code {
		display: block;
		font-family: var(--ncu-mono);
		overflow-wrap: anywhere;
	}

	.sub code {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sub .req {
		-webkit-line-clamp: 1;
	}

	.sub .ans,
	li .ans {
		color: var(--ncu-plate-ink-2);
	}

	/* The call's time wraps whole, never leaving "ms" alone on a line. */
	.ans span {
		white-space: nowrap;
	}

	[data-error] .ans {
		color: var(--ncu-stop-plate);
	}

	.toggle {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		min-width: 4.5rem;
		min-height: 2.75rem;
		padding: 0 1rem;
		border: 0;
		border-radius: 999px;
		background: var(--ncu-plate-raised);
		color: var(--ncu-plate-ink);
		font: 600 0.875rem/1 var(--ncu-sans);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			transform 140ms var(--ncu-ease);
	}

	.toggle:hover {
		background: var(--ncu-plate-hover);
	}

	.toggle:active {
		transform: scale(0.96);
	}

	.toggle:focus-visible {
		outline-color: var(--ncu-plate-ink);
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: start;
		gap: 0.25rem 1.5rem;
		padding: 0 clamp(1rem, 3vw, 2.5rem) 1.1rem;
		color: var(--ncu-plate-ink-2);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.note {
		margin: 0;
		max-width: 46ch;
	}

	details {
		flex-basis: 100%;
	}

	summary {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		cursor: pointer;
		color: var(--ncu-plate-ink);
		font-weight: 600;
	}

	summary:focus-visible {
		outline-color: var(--ncu-plate-ink);
	}

	ol {
		list-style: none;
		margin: 0.25rem 0 0.5rem;
		padding: 0;
		display: grid;
		gap: 0.6rem;
		font-size: 0.875rem;
		color: var(--ncu-plate-ink);
	}

	li {
		display: grid;
		grid-template-columns: 3.2rem 1fr;
		column-gap: 0.75rem;
	}

	li .time {
		grid-row: span 2;
		font-variant-numeric: tabular-nums;
		color: var(--ncu-plate-ink-2);
	}

	li[data-you] code {
		color: var(--ncu-plate-ink-2);
	}
</style>
