---
// Starlight's head, plus a preload of the text face cut to the site's characters, so headings
// are set in it from the first paint instead of moving when it arrives.
import Default from '@astrojs/starlight/components/Head.astro';
import archivo from '../generated/archivo-text.woff2?url';
---

<Default />
<link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
