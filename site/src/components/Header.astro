---
// The home page's header is a bar like a niri desktop's: the workspaces (the page's sections)
// with the one in view lit, the lease, which the hero's recording takes and gives back as it
// plays, and the stop key. Other pages keep Starlight's header.
import Default from '@astrojs/starlight/components/Header.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { workspaces } from '../lib/workspaces.mjs';

const home = Astro.locals.starlightRoute.id === '';
---

{
	home ? (
		<div class="ncu-bar">
			<div class="title">
				<SiteTitle />
			</div>
			<p class="here" data-here aria-hidden="true">
				<span>{workspaces[0].name}</span>
			</p>
			<nav class="workspaces" aria-label="Sections">
				{workspaces.map(({ id, name }, index) => (
					<a href={`#${id === 'demo' ? '_top' : id}`} data-pill={id}>
						{name}
						{index === 0 && <ncu-ring class="ncu-lit" aria-hidden="true"></ncu-ring>}
					</a>
				))}
			</nav>
			<p class="lease" data-lease data-held="false">
				lease <span class="free">free</span>
				<span class="held">held by the agent</span>
			</p>
			<a class="stop" href="#ncu-stop-title" aria-label="The stop key, Mod+Shift+Escape">
				<kbd data-key="mod">Mod</kbd>
				<kbd data-key="shift">Shift</kbd>
				<kbd data-key="esc">Esc</kbd>
			</a>
			<div class="search">
				<Search />
			</div>
			<div class="right">
				<SocialIcons />
				<ThemeSelect />
			</div>
		</div>
	) : (
		<Default />
	)
}

<style>
	.ncu-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}

	/* The name never gives up width; search, the flexible item, does. */
	.title {
		flex-shrink: 0;
		min-width: 0;
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
	}

	.workspaces,
	.lease,
	.stop,
	.right {
		display: none;
	}

	.search {
		display: flex;
		margin-inline-start: auto;
	}

	.workspaces {
		gap: 0.35rem;
	}

	/* A workspace pill. The one for the section in view is lit by a ring that slides along
	   the bar to it, so the pills themselves never change size. */
	.workspaces a {
		position: relative;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--ncu-rule);
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: color 200ms ease;
	}

	.workspaces a:hover,
	.workspaces a[aria-current] {
		color: var(--sl-color-white);
	}

	.ncu-lit {
		position: absolute;
		inset: -1px;
		border: 1px solid var(--ncu-ring);
		border-radius: 999px;
		pointer-events: none;
	}

	/* On a screen too narrow for the pills, the name of the workspace in view, in a lit pill.
	   Names change by sliding, as niri's workspaces do. */
	.here {
		display: grid;
		justify-items: center;
		min-width: 4.5rem;
		margin: 0;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--ncu-ring);
		border-radius: 999px;
		overflow: clip;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-white);
		white-space: nowrap;
	}

	.here > :global(span) {
		grid-area: 1 / 1;
	}

	.lease {
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.15rem 0.6rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 6px;
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		color: var(--sl-color-gray-3);
		white-space: nowrap;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}

	.lease .held,
	.lease[data-held='true'] .free {
		display: none;
	}

	.lease[data-held='true'] {
		border-style: solid;
		border-color: var(--ncu-ring);
		color: var(--sl-color-white);
	}

	.lease[data-held='true'] .held {
		display: inline;
	}

	.stop {
		align-items: center;
		gap: 0.2rem;
		text-decoration: none;
	}

	.stop kbd {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--sl-color-gray-4);
		border-bottom-width: 2px;
		border-radius: 5px;
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		color: var(--sl-color-gray-2);
		background: none;
		transition:
			border-color 80ms ease,
			border-width 80ms ease,
			color 80ms ease;
	}

	.stop:hover kbd {
		border-color: var(--sl-color-gray-3);
		color: var(--sl-color-white);
	}

	/* A key held down on the reader's keyboard sinks: its travel moves from the bottom edge
	   to the top, so the key's box keeps its size. */
	.stop kbd:global(.down) {
		border-color: var(--ncu-ring);
		border-top-color: transparent;
		border-width: 2px 1px 1px;
		color: var(--sl-color-white);
	}

	.right {
		align-items: center;
		gap: 1rem;
	}

	.right::before {
		content: '';
		height: 2rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		.lease,
		.stop,
		.right {
			display: flex;
		}

		.search {
			margin-inline-start: 0;
		}

		.lease {
			margin-inline-start: auto;
		}
	}

	@media (min-width: 80rem) {
		.workspaces {
			display: flex;
			margin-inline-start: 1rem;
		}

		.here {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.workspaces a,
		.lease,
		.stop kbd {
			transition: none;
		}
	}
</style>
