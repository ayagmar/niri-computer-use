---
// The home page's hero, drawn as a niri screen: a strip of windows with the focus ring on the
// promise, the errand recording stacked over the agent's calls in the next column, and the
// stop key in a column that runs off the right edge on a narrower screen, as niri leaves one.
// The stop key's keycaps answer the reader's own keys.
// Other pages with a hero keep Starlight's.
import Default from '@astrojs/starlight/components/Hero.astro';
import { HERO_SIZES, HERO_WIDTHS, loadDemo } from '../lib/demo';
import Calls from './Calls.astro';
import FocusRing from './FocusRing.astro';
import Recording from './Recording.astro';

// Starlight's id for the page title, which its skip link names.
const PAGE_TITLE_ID = '_top';

const { id, entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
const demo = id === '' ? await loadDemo('errand', HERO_WIDTHS) : undefined;
---

{
	demo ? (
		<section class="ncu-desk not-content" aria-labelledby={PAGE_TITLE_ID} data-workspace="demo">
			<div class="strip">
				<div class="win you focused">
					<FocusRing />
					<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
					<div class="lower">
						{tagline && <p class="tagline" set:html={tagline} />}
						<div class="actions">
							{actions.map(({ link, text, variant }) => (
								<a class:list={['button', variant === 'primary' ? 'primary' : 'quiet']} href={link}>
									{text}
								</a>
							))}
						</div>
						<p class="needs">
							niri 26.04 · Linux, Wayland · built from source · <a href={`${base}#limits`}>limits</a>
						</p>
					</div>
				</div>
				<div class="column">
					<figure class="win recording">
						<Recording
							demo={demo}
							lead
							label="In Files, the agent selects the two screenshots, makes a folder for them from the right-click menu, names it release-0.1, then puts focus back on its terminal."
							sizes={HERO_SIZES}
						/>
						<figcaption>
							{demo.note && <p class="note">{demo.note}</p>}
							{demo.output && <p class="output">{demo.output}</p>}
						</figcaption>
					</figure>
					<div class="win agent">
						<p class="asked">
							<span>asked</span> {demo.prompt}
						</p>
						<Calls demo={demo} scrolls />
					</div>
				</div>
				<aside class="win stop" aria-labelledby="ncu-stop-title">
					<button class="keys" type="button" data-stop aria-label="Mod Shift Escape: stop the recording">
						<kbd data-key="mod">Mod</kbd>
						<kbd data-key="shift">Shift</kbd>
						<kbd data-key="esc">Escape</kbd>
					</button>
					<p class="stopped" data-stopped-note aria-live="polite"></p>
					<h2 id="ncu-stop-title">The stop key</h2>
					<p>
						Bind a key to <code>niri-computer-use stop</code>. It cancels the running action and takes
						the lease back. An agent can't press it.
					</p>
					<p>
						Guardrails, not a sandbox: an agent holding the lease can do what you can with a keyboard
						and mouse. <a href={`${base}concepts/safety/#what-isnt-a-boundary`}>What isn't a boundary</a>
					</p>
				</aside>
			</div>
		</section>
	) : (
		<Default />
	)
}

<script>
	// Keyboard focus on a window past the screen's edge brings it in, as niri does.
	document.querySelector('.ncu-desk')?.addEventListener('focusin', (event) => {
		(event.target as Element).scrollIntoView({ block: 'nearest', inline: 'nearest' });
	});

	// The keycaps on the page sink while the reader holds the same keys. Pressing the stop
	// window's keycaps stops the hero recording, frees the bar's lease tag and says so under
	// the keys until the recording plays again. Nothing reads the keyboard to stop it: the
	// real chord belongs to niri, and Shift+Escape to the browser.
	const names: Record<string, string> = { Meta: 'mod', OS: 'mod', Super: 'mod', Shift: 'shift', Escape: 'esc' };
	const press = (name: string, down: boolean) => {
		for (const key of document.querySelectorAll(`kbd[data-key="${name}"]`)) key.classList.toggle('down', down);
	};
	const release = () => Object.values(names).forEach((name) => press(name, false));

	const video = document.querySelector<HTMLVideoElement>('video[data-lease-source]');
	const note = document.querySelector<HTMLElement>('[data-stopped-note]');
	video?.addEventListener('play', () => {
		if (note) note.textContent = '';
	});

	function stop() {
		if (!video) return;
		video.dataset.stopped = '';
		video.pause();
		const lease = document.querySelector<HTMLElement>('[data-lease]');
		if (lease) lease.dataset.held = 'false';
		if (note) note.textContent = 'The recording is stopped. Play it again from its controls or a call.';
	}

	addEventListener('keydown', (event) => {
		const name = names[event.key];
		if (name) press(name, true);
	});
	addEventListener('keyup', (event) => {
		const name = names[event.key];
		if (name) press(name, false);
	});
	addEventListener('blur', release);

	document.querySelector('[data-stop]')?.addEventListener('click', () => {
		for (const name of Object.values(names)) press(name, true);
		setTimeout(release, 160);
		stop();
	});
</script>

<style>
	/* The screen: as wide as the window, right under the bar (out of Starlight's content
	   padding), with niri's 16px gaps. */
	.ncu-desk {
		--gap: 1rem;
		width: 100vw;
		margin: -1.5rem calc(50% - 50vw) 0;
		padding: var(--gap) 0;
	}

	.strip {
		display: grid;
		gap: var(--gap);
		padding-inline: var(--gap);
	}

	.win {
		min-width: 0;
		margin: 0;
		border: 1px solid var(--ncu-rule);
		border-radius: var(--ncu-radius);
		background: var(--ncu-panel);
	}

	/* The focused window, which the page's focus ring starts on. */
	.you {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: clamp(1.25rem, 0.9rem + 1vw, 2.25rem);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 1rem + 2.6vw, 4.75rem);
		line-height: 1.02;
		font-weight: 680;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	h1 :global(.key) {
		display: block;
		margin-top: 0.15em;
		color: var(--ncu-ring);
	}

	.lower {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-top: clamp(1.5rem, 1rem + 2vh, 3rem);
	}

	.tagline {
		max-width: 34rem;
		font-size: clamp(var(--sl-text-base), 0.9rem + 0.3vw, var(--sl-text-lg));
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: 1.15rem;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			border-color 150ms ease;
	}

	.primary {
		background: var(--ncu-ring);
		color: var(--sl-color-black);
	}

	.primary:hover {
		background: var(--sl-color-accent-high);
	}

	:root[data-theme='light'] .primary {
		color: #fff;
	}

	:root[data-theme='light'] .primary:hover {
		background: var(--sl-color-accent);
	}

	.quiet {
		border: 1px solid var(--ncu-rule);
		color: var(--sl-color-white);
	}

	.quiet:hover {
		border-color: var(--sl-color-gray-3);
	}

	/* The requirements sit at the window's foot, like a status line. */
	.needs {
		margin-top: auto;
		padding-top: 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.needs a {
		color: inherit;
	}

	/* A niri column holding two windows. */
	.column {
		display: flex;
		flex-direction: column;
		gap: var(--gap);
		min-width: 0;
	}

	.recording {
		border: 0;
		background: none;
	}

	.recording :global(.plate) {
		border-color: var(--ncu-rule);
	}

	.recording figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}

	.note {
		flex: 1 1 24rem;
		max-width: 44rem;
	}

	.output {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
	}

	.agent {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0.9rem 0.6rem 0.9rem 0.9rem;
	}

	.asked {
		padding-inline: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}

	.asked span {
		margin-inline-end: 0.35rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.stop {
		padding: clamp(1.25rem, 0.9rem + 1vw, 2rem);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.stop a {
		color: var(--sl-color-text-accent);
	}

	.stop > * + * {
		margin-top: 0.9rem;
	}

	/* The keycaps press as a button, so the hit area spans the row at full height. */
	.keys {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		min-height: 2.75rem;
		margin: -0.125rem;
		padding: 0.125rem;
		border: 0;
		border-radius: 10px;
		background: none;
		font: inherit;
		cursor: pointer;
	}

	kbd {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0 0.8rem;
		border: 1px solid var(--sl-color-gray-4);
		border-bottom-width: 3px;
		border-radius: 8px;
		background: var(--sl-color-black);
		background-clip: padding-box;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		transition:
			border-color 80ms ease,
			border-width 80ms ease;
	}

	.keys:hover kbd {
		border-color: var(--sl-color-gray-3);
	}

	/* A held key sinks: its 3px travel moves from the bottom edge to the top, where it shows
	   the window behind, so the key's box keeps its size. */
	kbd:global(.down) {
		border-color: var(--ncu-ring);
		border-top-color: transparent;
		border-width: 3px 1px 1px;
	}

	.stopped {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}

	.stopped:empty {
		display: none;
	}

	.stop h2 {
		margin-top: 1.5rem;
		font-size: var(--sl-text-h4);
		font-weight: 660;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}

	/* Stacked, the calls scroll in their own window rather than run the page long. */
	@media (max-width: 61.99rem) {
		.agent :global(.ncu-calls) {
			max-height: 22rem;
			overflow-y: auto;
		}
	}

	/* From here the strip runs sideways as niri's does: as tall as the screen, columns at
	   their own widths, and the last one past the right edge until there's room for it. */
	@media (min-width: 62rem) {
		.ncu-desk {
			height: clamp(38rem, calc(100svh - var(--sl-nav-height)), 72rem);
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scrollbar-width: thin;
			scrollbar-color: var(--sl-color-gray-5) transparent;
		}

		.strip {
			grid-template-columns: clamp(24rem, 33vw, 36rem) clamp(34rem, 52vw, 68rem) clamp(18rem, 24vw, 26rem);
			grid-template-rows: minmax(0, 1fr);
			width: max-content;
			height: 100%;
			margin-inline: auto;
		}

		.agent {
			flex: 1;
			min-height: 0;
		}

		.agent :global(.ncu-calls) {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
			align-content: start;
			scrollbar-width: thin;
			scrollbar-color: var(--sl-color-gray-5) transparent;
		}
	}

	/* The columns open one after another from the right, as niri opens new columns beside
	   the focused one and scrolls them in, and the ring lands on the promise once they have.
	   Only transforms move, so the first paint holds everything at its place in the page. */
	@media (prefers-reduced-motion: no-preference) {
		.strip > * {
			animation: ncu-open 680ms cubic-bezier(0.16, 1, 0.3, 1) both;
		}

		.strip > :nth-child(2) {
			animation-delay: 70ms;
		}

		.strip > :nth-child(3) {
			animation-delay: 140ms;
		}

		/* The ring as the page renders it, first in the window. A ring moved back here later
		   comes last, and slides in without landing again. */
		.you > :global(.ncu-ring:first-child) {
			animation: ncu-land 320ms cubic-bezier(0.16, 1, 0.3, 1) 420ms both;
		}
	}

	@keyframes ncu-open {
		from {
			translate: 4rem 0;
		}
	}

	@keyframes ncu-land {
		from {
			border-color: var(--ncu-rule);
			scale: 1.012;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		kbd {
			transition: none;
		}
	}
</style>
